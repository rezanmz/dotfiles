#!/bin/sh
# Toggle screen recording — a thin wrapper over the shell's recorder.
#
#   not recording -> start a region recording (as it always did)
#   recording     -> stop the current recording
#
# The implementation lives in the shell now (dot_config/quickshell/Recorder.qml
# owns the wf-recorder process and its state, Capture.qml the file name and the
# region selection). This only forwards to the running shell over IPC.
set -eu

exec qs ipc call capture toggleRecording
