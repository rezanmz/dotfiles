// Waybar: Dracula, one row, right-anchored status cluster.
// Nerd Font glyphs live in the Unicode private use area. They are written here
// as JSON \u escapes so the file itself stays plain ASCII and cannot be mangled
// by tooling; waybar decodes them at parse time. With the Nerd Font installed
// (ttf-hack-nerd) these render as icons; without it they fall back to the text
// labels below.

{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 8,
    "margin-top": 0,
    "margin-left": 10,
    "margin-right": 10,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window", "hyprland/language"],
    "modules-center": [],
    "modules-right": ["idle_inhibitor", "mpris", "pulseaudio", "network", "custom/speed", "bluetooth", "cpu", "memory", "temperature", "disk", "clock", "tray"],

    // Workspaces are listed as they exist: only workspaces that actually have a
    // window appear, so there is no empty clutter. (An invalid "num-workspaces"
    // key used to live here; waybar silently ignored it.)
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Google Chrome": "$1",
            "(.*) - Chromium": "$1"
        }
    },

    // Active keyboard layout (US / Persian). Read-only indicator; the layouts
    // are switched with Ctrl+Space by XKB's grp:ctrl_space_toggle, set in
    // 50-input.lua.
    //
    // The format-<key> suffixes must be XKB's shortDescription, not the layout
    // code: "us" has shortDescription "en" and "ir" has "fa". Using
    // format-us/format-ir silently falls through to the bare "format", which
    // is why the bar showed the raw layout name before.
    // "format" is positional here: when a format-<key> override matches, waybar
    // formats "format" with that override's value as the first argument. A
    // named placeholder like {short} makes waybar log "argument not found" and
    // DISABLE the whole module on 0.15.0.
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-fa": "FA",
        "tooltip-format": "{long} ({variant})",
        "on-click": ""
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#ff79c6'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "interval": 5,
        "format": "cpu {usage}%",
        "on-click": "kitty -e htop"
    },

    "memory": {
        "interval": 10,
        "format": "ram {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted \uf026",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        // interval drives the bandwidth figures, so it is the sample window:
        // every 2s the module computes delta-bytes/elapsed. Shorter = snappier
        // but more IPC traffic.
        "interval": 2,
        "format-wifi": "{signalStrength}% \uf1eb",
        "format-ethernet": "eth \uf6ff",
        "format-disconnected": "offline \uf127",
        // Throughput only appears when it is worth looking at: a placeholder
        // that resolves to an empty string (below 1 KiB/s) leaves no gap.
        "format-linked": "{ifname} \uf6ff {bandwidthDownBytes:>} \uf0ab {bandwidthUpBytes:>}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
        "on-click": "kitty -e nmtui"
    },

    // Dedicated throughput readout, so "what is my speed right now" is visible
    // without hovering. Its own interval keeps the bar refresh independent of
    // the signal-strength module above.
    "custom/speed": {
        "exec": "~/.local/bin/net-speed",
        "interval": 2,
        "format": "{}",
        "tooltip": false,
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "interval": 10,
        "format": "\uf293 {num_connections}",
        "format-disabled": "\uf293 off",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty -e bluetui"
    },

    "mpris": {
        // Only appears while a player is active, so the bar stays clean.
        "format": "{player} {status_icon} {dynamic}",
        "format-paused": "{player} {dynamic}",
        "dynamic-len": 40,
        "dynamic-order": "title artist album",
        "dynamic-importance-order": "title artist album",
        "status-icons": {
            "playing": "▶",
            "paused": "❚❚",
            "stopped": "■"
        },
        "max-length": 60,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "idle_inhibitor": {
        // Toggle: click to stop hypridle locking the screen (e.g. watching a
        // long video). Readable word instead of a Nerd Font glyph, since a
        // missing glyph would silently render as a blank module.
        "format": "{icon}",
        "format-icons": {
            "activated": "hold",
            "deactivated": "idle"
        },
        "tooltip-format-activated": "idle lock is INHIBITED (click to allow)",
        "tooltip-format-deactivated": "idle lock is ACTIVE (click to inhibit)"
    },

    "temperature": {
        // hwmon-path-abs pins the CPU sensor by PCI path: plain hwmonN numbering
        // is assigned in probe order and changes between boots.
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "format": "{temperatureC}°C",
        "tooltip-format": "CPU (Tctl): {temperatureC}°C",
        "warning-threshold": 75,
        "critical-threshold": 90
    },

    "disk": {
        // Root is a single LVM/btrfs volume, so one entry is enough. Note the
        // space in the mount point has to be escaped in the JSON key.
        "interval": 30,
        "format": "{used}",
        "tooltip-format": "root: {used} / {total} ({percentage_used}%)",
        "path": "/",
        "unit": "GiB"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
