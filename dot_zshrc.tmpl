# Enable Powerlevel10k instant prompt. Keep this near the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh, when present (macOS and machines that install it).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Powerlevel10k without oh-my-zsh. Arch ships the theme via
# zsh-theme-powerlevel10k, installed to this path. Keep this after the
# oh-my-zsh block so the "direct" source wins when oh-my-zsh is absent, and
# skip it when oh-my-zsh already loaded the theme.
if [[ ! -r "$ZSH/oh-my-zsh.sh" ]]; then
  for _p10k in \
      /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
      "$HOME/.local/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme"; do
    [[ -r "$_p10k" ]] && { source "$_p10k"; break; }
  done
  unset _p10k
fi

# Keep the useful colorized, time-sorted alias on both macOS and Linux.
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -ltrhG'
elif [[ "$OSTYPE" == linux* ]]; then
  alias ls='ls -ltrh --color=auto'
fi

# omp is the daily driver; all model roles live in ~/.omp/agent/config.yml.

# Load the prompt only when it is present.
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

# Optional tools are added only when installed locally.
[[ -d "$HOME/.cache/lm-studio/bin" ]] && export PATH="$HOME/.cache/lm-studio/bin:$PATH"
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

# Conda initialization is optional and never assumes a fixed home directory.
_conda_bin=""
if [[ -x "$HOME/miniconda3/bin/conda" ]]; then
  _conda_bin="$HOME/miniconda3/bin/conda"
elif (( $+commands[conda] )); then
  _conda_bin="${commands[conda]}"
fi
if [[ -n "$_conda_bin" ]]; then
  __conda_setup="$("$_conda_bin" shell.zsh hook 2>/dev/null)"
  if [[ $? -eq 0 ]]; then
    eval "$__conda_setup"
  else
    _conda_base="$("$_conda_bin" info --base 2>/dev/null)"
    if [[ -r "$_conda_base/etc/profile.d/conda.sh" ]]; then
      source "$_conda_base/etc/profile.d/conda.sh"
    fi
  fi
fi
unset _conda_bin _conda_base __conda_setup

# The work profile name is machine-local; it is never stored in this repository.
{{- if eq .machine "work" }}
if [[ -n "${WORK_AWS_PROFILE:-}" ]]; then
  export AWS_DEFAULT_PROFILE="$WORK_AWS_PROFILE"
fi
{{- end }}

{{- if eq .machine "work" }}
# Keep web search and background integrations off on work machines.
unset OPENCODE_ENABLE_EXA OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS
{{- else }}
# Enable the current personal OpenCode integrations.
if [[ -z "${CONTEXT7_API_KEY:-}" && -r "$HOME/.config/context7/credentials.json" ]] && (( $+commands[jq] )); then
  CONTEXT7_API_KEY="$(jq -r '.access_token // empty' "$HOME/.config/context7/credentials.json" 2>/dev/null)"
  [[ -n "$CONTEXT7_API_KEY" ]] && export CONTEXT7_API_KEY
fi
export OPENCODE_ENABLE_EXA=1
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
{{- end }}

if (( $+commands[fastfetch] )); then
  # Run the banner on the first prompt so it does not steal the instant prompt.
  #
  # --pipe false is required, not decorative. While p10k's instant prompt is
  # active, fd 1 points at its capture file (/tmp/p10k-instant-prompt-output-*)
  # rather than the terminal, so deferring to precmd is not enough: fastfetch
  # sees a non-tty stdout, applies --pipe, and prints the logo with no colors.
  # Verified by having the hook read `readlink /proc/$$/fd/1`. Forcing color
  # here matches running fastfetch by hand, which looks right only because by
  # then p10k has finished and stdout is the real terminal again.
  autoload -Uz add-zsh-hook
  _fastfetch_banner() {
    add-zsh-hook -d precmd _fastfetch_banner
    fastfetch --pipe false
  }
  add-zsh-hook precmd _fastfetch_banner
fi

# --- Completion system ---------------------------------------------------
# compinit MUST run, or Tab completion does nothing at all: fpath alone only
# makes the functions *findable*. oh-my-zsh used to call compinit for us; when
# this config stopped sourcing it (see the Powerlevel10k block above) that call
# was lost, which is why `sudo systemc<Tab>` did not complete.
fpath=(/usr/share/zsh/site-functions /usr/share/zsh/functions/Completion/* $fpath)
autoload -Uz compinit
# -C skips the security check on an existing dump file (much faster startup);
# regenerate with `rm -f ~/.zcompdump* && exec zsh` if completions look stale.
compinit -C

# Case-insensitive, menu-style matching: partial-word and substring matching
# make `systemc<Tab>` work even without typing the full word.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors ''
# Complete sudo's arguments as if the prefix were not there, so
# `sudo systemctl <Tab>` offers systemctl's own completions.
zstyle ':completion:*:sudo:*' command-path /usr/sbin /usr/bin /sbin /bin
# Grouping + descriptions in the menu.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
setopt MENU_COMPLETE

# --- Suggestions and highlighting ----------------------------------------
# zsh-autosuggestions: grey inline suggestions from history (Right/End accepts).
if [[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# zsh-syntax-highlighting MUST be sourced last: it wraps the line editor, and
# anything sourced after it would not be highlighted. It also declares the
# zsh-users/zsh-autosuggestions compatibility strategy above.
if [[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# History shared across terminals.
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
