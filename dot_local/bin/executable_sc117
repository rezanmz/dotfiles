#!/bin/sh
# SC117 Qwen3.8-Flash-Next GSQ-RCO-abliterated Q2_0 — Strata engine on the RX 9070 XT (16 GB) + 30 GiB RAM.
#
# Weights: SC117/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-GGUF, the Q2_0 tier (2.25 bpw mixed per-tensor).  It is the
# only tier that fits this computer: Strata's catalogue rates Q2_0 "fits" and IQ2_XS / IQ3_XXS / IQ3_S "too big"
# (4.1 / 11.5 / 18.9 GB of experts would have to be read from the SSD).
#   shard 1  38.0 GB  weights, ~34 GB of them experts; decode reads them from <pack>/experts.bin
#   shard 2  28.8 GB  the n-gram (PLE) table, mmap'd: one row per token, never resident
#
# Measured 2026-11-12 on this box (Strata 0.2.9 + engine 0.1.59-hip, 16 GB card, 30.5 GiB RAM, WD_BLACK SN850X):
#   first start      engine 674 MB, pack ~40 GB, draft 5.2 GB, reader 0.9 GB -> ready in 5.4 min; later starts ~20 s.
#   fit              experts 34.0 GB, all of it mmap'd from <pack>/experts.bin (low-RAM mode is automatic here:
#                    30.5 < 34 + 10), so no anonymous arena is swapped; KV stays in VRAM.
#   VRAM             15.9/15.9 GiB reported: expert cache 5.68 GiB = 4408 slots, MTP 950 MiB, and the 2048 MiB
#                    reserve is held by the engine's plan ("8.11 GiB free, 2048 reserved").
#   decode           22-48 tok/s (expert-cache hit rate 67-84%, `route tail skip` on by default: a ranked-out
#                    missed expert is skipped, STRATA_ROUTE_TAIL_SKIP=0 for exactness -- answers differ slightly).
#   prompt           two caches, and only one of them can help.  An identical prefix is reused from the KV park
#                    (655 of 660 tokens in 147 ms; 8886 of 8905 in 520 ms).  The weights cannot be cached: 31.6 GiB
#                    of experts against ~19-22 GiB of page cache, so Strata's own plan reads ~100 GB off the drive
#                    for every new 32K of context (its "the file set does not fit" line) -- that is the 10-40 s a
#                    new session, a new prompt or a helper call costs, and it grows as the page cache shrinks.
#                    Keep one conversation; RESERVE=2048 hands 1 GiB back to the desktop and costs ~800 slots.
#   pictures         272-token image: 5.9 s prompt, 121 tokens out in 4.4 s, read the text and colours correctly.
#   memory           AnonPages 3.4 GiB, page cache 23.4 GiB, zram 4.5 GiB in use while serving.
#   context cost     15,360 elements/token (12 full-attention layers x 2 KV heads x 256, + 12 QSA indexer rows x 256).
#                    int8: 0.50 GiB at 32K, 1.00 at 64K, 1.99 at 128K, 3.98 at 262K
#                    k8v4: 0.40 / 0.81 / 1.62 / 3.24           q4_0: 0.26 / 0.53 / 1.05 / 2.11
#                    the 36 DeltaNet layers cost a fixed 112 MiB at any context.
#   pictures         GPU (HIP) reader: 1,024 image tokens a picture, ~0.2 s.  It costs 700 MiB of reserve plus
#                    ~1-1.4 GB of the expert cache, so `strata launch`'s own default is the CPU reader (300 image
#                    tokens, ~1.7 s) -- VISION=cpu picks that and returns ~1 GB to the experts; VISION=off disables.
#   RAM              the desktop keeps its live 4 GiB; expert pages are reclaimable cache, so a heavy browser makes
#                    both slower.  swappiness is 180 here, i.e. the kernel pushes desktop pages into zram before it
#                    drops expert cache — backwards for serving: `sudo sysctl -w vm.swappiness=20` while serving.
#
# The first start writes the Q2_0 pack (~40 GB, 2-5 min) and fetches the engine.  Stop it with `strata launch --stop`.
# Point omp at it with: omp --profile sc117
#
# Env: CTX (131072), KV (k8v4), VISION (gpu), PORT (8080), MTP (1), RESERVE (2048), RESTART (0), PLAN (0),
#      MODEL_DIR (~/models/sc117-flash-next/Q2_0), STRATA (strata)
set -e

STRATA=${STRATA:-strata}
MODEL_DIR=${MODEL_DIR:-$HOME/models/sc117-flash-next/Q2_0}
CTX=${CTX:-131072}
KV=${KV:-k8v4}
VISION=${VISION:-gpu}
PORT=${PORT:-8080}
MTP=${MTP:-1}
RESERVE=${RESERVE:-1024}

if ! command -v "$STRATA" >/dev/null 2>&1; then
  echo "sc117: $STRATA not found on PATH (strata launch is the engine front end)." >&2
  exit 1
fi

first=$(ls "$MODEL_DIR"/*-00001-of-00002.gguf 2>/dev/null | head -n 1 || true)
if [ -z "$first" ]; then
  echo "sc117: no first shard (*-00001-of-00002.gguf) in $MODEL_DIR" >&2
  echo "       fetch it there, or set MODEL_DIR=... (see the model card's Q2_0 folder)." >&2
  exit 1
fi

# Never start on a busy port: the client would silently talk to whatever else is listening (PLAN only prints).
if [ "${PLAN:-0}" != "1" ] && command -v ss >/dev/null 2>&1 && ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
  echo "sc117: port $PORT is already in use -- another server is running there." >&2
  echo "       strata launch --status   (reuse it, or PORT=8081 sc117, or RESTART=1 sc117)" >&2
  exit 1
fi

set -- --model-path "$MODEL_DIR" --context "$CTX" --kv "$KV" --vision "$VISION" --parallel 1 \
       --port "$PORT" --set "vram-reserve-mib=$RESERVE" --set STRATA_PREFILL_CPU_SHARE=auto --no-tui --yes
if [ "$MTP" = "1" ]; then
  set -- "$@" --mtp on
else
  set -- "$@" --mtp off
fi
[ "${RESTART:-0}" = "1" ] && set -- "$@" --restart
[ "${PLAN:-0}" = "1" ] && set -- "$@" --plan

echo "sc117: Q2_0 abliterated | ctx $CTX | kv $KV | vision $VISION | reserve ${RESERVE} MiB | mtp $MTP | port $PORT"
exec "$STRATA" launch "$@"
