providers:
  webSearchOrder:
    - ecosia
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - startpage
    - duckduckgo
    - google
    - mojeek
    - public
modelRoles:
{{- if eq .machine "work" }}
  default: github-copilot/gpt-5.6-terra:high
  slow: github-copilot/claude-opus-5:max
  smol: github-copilot/gemini-3.7-flash:low
  vision: github-copilot/claude-sonnet-5:high
  plan: github-copilot/gpt-5.6-sol:xhigh
  designer: github-copilot/claude-sonnet-5:high
  commit: github-copilot/gpt-5.6-luna:low
  tiny: github-copilot/gpt-5.6-luna:low
  task: github-copilot/gpt-5.6-terra:high
  advisor: github-copilot/grok-4.6:high
{{- else }}
  default: opencode-go/qwen3.8-flash:high
  slow: openrouter/deepseek/deepseek-v4.1-flash:max
  smol: opencode-go/deepseek-v4-flash
  vision: opencode-go/qwen3.8-flash:high
  plan: openrouter/deepseek/deepseek-v4.1-flash:max
  designer: opencode-go/qwen3.8-flash:high
  commit: opencode-go/deepseek-v4-flash:low
  tiny: opencode-go/deepseek-v4-flash:minimal
  task: opencode-go/qwen3.8-flash:high
  advisor: opencode-go/qwen3.8-flash:high
{{- end }}
advisor:
  enabled: false
task:
  eager: preferred
  batch: true
  maxConcurrency: {{ if eq .machine "work" }}8{{ else }}4{{ end }}
  maxRecursionDepth: {{ if eq .machine "work" }}2{{ else }}1{{ end }}
  softRequestBudget: {{ if eq .machine "work" }}200{{ else }}100{{ end }}
  enableEffort: true
  enableLsp: true
  showResolvedModelBadge: true
  isolation:
    apply: true
    merge: patch
    enabled: true
  agentModelOverrides:
    security-reviewer: "@slow"
retry:
  enabled: true
  modelFallback: true
  usageAwareFallback: false
  fallbackChains:
{{- if eq .machine "work" }}
    default:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/grok-4.6:high
    slow:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-4.8:high
    plan:
      - github-copilot/claude-opus-5:max
      - github-copilot/claude-opus-4.8:high
    smol:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash:low
    task:
      - github-copilot/gpt-5.6-sol
      - github-copilot/gpt-5.3-codex:high
    vision:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    designer:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    commit:
      - github-copilot/mai-code-1.1-flash
    tiny:
      - github-copilot/mai-code-1.1-flash
    advisor:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gpt-5.6-terra:high
{{- else }}
    # 9Router combos first: chat (everyday flash tier) for coding/cheap
    # roles, smart (heavy reasoning tier) for the rest. Existing
    # direct-provider entries retained as deeper fallbacks.
    default:
      - 9router/chat:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    slow:
      - 9router/smart:high
      - opencode-go/qwen3.8-max:high
      - openrouter/qwen/qwen3.8-max:xhigh
      - openrouter/moonshotai/kimi-k3:max
    plan:
      - 9router/smart:high
      - opencode-go/qwen3.8-max:high
      - openrouter/qwen/qwen3.8-max:xhigh
      - openrouter/moonshotai/kimi-k3:max
    smol:
      - 9router/chat
      - opencode-go/qwen3.8-flash
      - openrouter/deepseek/deepseek-v4.1-flash
      - openrouter/qwen/qwen3.8-flash
    task:
      - 9router/chat:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    vision:
      - 9router/smart:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    designer:
      - 9router/smart:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    commit:
      - 9router/chat:low
      - opencode-go/qwen3.8-flash:low
      - openrouter/deepseek/deepseek-v4.1-flash:low
      - openrouter/qwen/qwen3.8-flash:low
    tiny:
      - 9router/chat:minimal
      - opencode-go/qwen3.8-flash:minimal
      - openrouter/deepseek/deepseek-v4.1-flash:low
      - openrouter/qwen/qwen3.8-flash:minimal
    advisor:
      - 9router/smart:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
{{- end }}
symbolPreset: nerd
theme:
  dark: titanium
  light: light
setupVersion: 2
dev:
  autoqaConsent: granted
composer:
  shape: box
defaultThinkingLevel: auto
isolation:
  backend: auto
memory:
  backend: local
checkpoint:
  enabled: true
secrets:
  enabled: true
compaction:
  idleEnabled: true
  handoffSaveToDisk: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
terminal:
  showProgress: true
statusLine:
  preset: custom
  leftSegments:
    - model
    - mode
    - path
    - git
    - pr
  rightSegments:
    - context_pct
    - token_total
    - cost
    - time_spent
    - subagents
    - status