#!/bin/sh
# Generates ~/.local/share/applications/libreoffice-*.desktop overrides from
# the packaged /usr/share/applications/libreoffice-*.desktop entries, changing
# only the Exec= lines so that they point at the ~/.local/bin/libreoffice
# wrapper.
#
# The wrapper is the single source of truth for two things:
#
#   - the VCL backend pin (SAL_USE_VCLPLUGIN=gtk3), and
#   - the headless profile isolation.
#
# Pointing Exec at the wrapper rather than inlining the variable keeps the
# desktop entries and the wrapper from drifting apart. It also matters for
# the launcher: its execBasename() indexes an entry by the basename of the
# first Exec token, so an Exec line starting with "env" would make all eight
# entries searchable as "env" instead of "libreoffice".
#
# Run this after a LibreOffice update that changes the packaged entries.
# The chezmoi source of truth is dot_local/share/applications/ in the dotfiles
# repo; this script exists so the copies can be re-synced mechanically.
#
# Usage: regen-libreoffice-desktops [source-dir]
#   source-dir defaults to /usr/share/applications. Pass a directory holding
#   the extracted upstream entries (the real files live in
#   /usr/lib/libreoffice/share/xdg/, and /usr/share/applications/ holds
#   symlinks to them) to regenerate without a system-wide install.
set -e

SRC_DIR="${1:-/usr/share/applications}"
OUT_DIR=/home/reza/.local/share/chezmoi/dot_local/share/applications
WRAPPER=/home/reza/.local/bin/libreoffice

HEADER='#
# User-level override of the packaged LibreOffice desktop entry.
# (Comment lines are ignored by the Desktop Entry parser, so this header block
# is inert; the file has exactly one [Desktop Entry] group below.)
#
# WHY THIS EXISTS
#
# The packaged entry runs `libreoffice` with no environment pinning, so
# LibreOffice auto-detects its VCL (widget toolkit) backend. On this machine
# qt6-base is installed, and that lands on the Qt6/KF6 backend, which the
# ArchWiki flags for visible scroll lag on Wayland:
#
#   "When on Wayland with the VCL interface set to qt6, it can result in lag
#    spikes when scrolling quickly. Setting the environment variables to gtk3
#    seems to be mostly stable."
#
# The GTK3 backend is also the one that honours the system GTK theme
# (Dracula) and the Papirus-Dark icon theme, so LibreOffice matches the rest
# of the desktop. The GTK4 backend is still experimental upstream.
#
# WHY THIS POINTS AT THE WRAPPER
#
# ~/.config/environment.d/70-libreoffice.conf carries the same setting, but
# that file is read once by the systemd-environment-d-generator at session
# start. A desktop file Exec= line does not go through the generator, and
# neither do `hyprctl dispatch exec` or a bare `env` call, so those paths
# would silently fall back to auto-detection.
#
# The wrapper (~/.local/bin/libreoffice) applies the pin on every launch
# path, and it is also where the headless profile isolation lives, so the
# desktop entries and the wrapper cannot drift apart.
#
# The first Exec token is deliberately the wrapper path and not "env": the
# launcher indexes an entry by the basename of that token (execBasename in
# quickshell Launcher.qml), so an Exec line starting with "env" would make
# this entry searchable as "env" rather than "libreoffice".
#
# MAINTENANCE: generated from the packaged entry. After a LibreOffice update,
# re-run the generator; only the Exec lines are intentional changes.
'

mkdir -p "$OUT_DIR"

for src in "$SRC_DIR"/libreoffice-*.desktop; do
    [ -e "$src" ] || continue
    name=$(basename "$src")
    out="$OUT_DIR/$name"

    # /usr/share/applications/libreoffice-*.desktop are symlinks to
    # /usr/lib/libreoffice/share/xdg/{writer,calc,...}.desktop, whose base
    # names differ from the symlink names. Resolve to the real file so the
    # override is a copy of the actual entry.
    real=$(readlink -f "$src")

    {
        printf '%s\n' "$HEADER"
        # The packaged Exec lines start with a bare "libreoffice"; point them
        # at the wrapper instead. The wrapper is the single source of truth
        # for the VCL pin and the headless profile isolation, and keeping the
        # first Exec token a real executable name matters: the launcher's
        # execBasename() indexes entries by cmd[0]'s basename, so a leading
        # "env" would make all eight entries searchable as "env" instead of
        # "libreoffice".
        sed -e "s|^Exec=libreoffice\\b|Exec=$WRAPPER|" \
            "$real"
    } > "$out"

    echo "wrote $out"
done
