#!/bin/sh
# Live network throughput for the waybar custom/speed module.
#
# waybar's built-in {bandwidthDownBytes} can only appear inside the network
# module's own format; this script gives a standalone readout that shows
# DOWN/UP at a glance and stays compact when idle.
#
# OUTPUT IS FIXED WIDTH. That is the point, not a nicety: waybar re-renders the
# module on every poll, so any change in label length resizes it and shoves
# every module to its left sideways. Both the value and the unit used to vary
# in length ("12.3 MiB" vs "1.2 KiB" vs "idle"), which made the whole bar
# twitch every second. Every branch below emits the same number of characters.
#
# Reads byte counters twice, so it needs to exit — waybar calls it on an
# Width budget, in characters. Keep these in step with human() below.
#   "v 1234.5 MiB  ^ 1234.5 MiB" -> 12 + 2 + 12 = 26 characters, always.
# The placeholder for "no interface" is built with the same field widths so it
# cannot drift from the live output either.

# 12 characters: glyph, space, 6-wide value, space, 3-wide unit.
placeholder_half() { printf '%s %6s %-3s' "$1" "---" "---"; }

# Default route interface: works for wifi and ethernet alike.
iface=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
if [ -z "$iface" ]; then
    printf '%s  %s\n' "$(placeholder_half v)" "$(placeholder_half '^')"
    exit 0
fi

stats="/sys/class/net/$iface/statistics"
if [ ! -r "$stats/rx_bytes" ]; then
    printf '%s  %s\n' "$(placeholder_half v)" "$(placeholder_half '^')"
    exit 0
fi



read_rx_tx() {
    read -r rx < "$stats/rx_bytes"
    read -r tx < "$stats/tx_bytes"
    echo "$rx $tx"
}

set -- $(read_rx_tx)
rx1=$1; tx1=$2
sleep 1
set -- $(read_rx_tx)
rx2=$1; tx2=$2

human() {
    # $1 = bytes, $2 = direction glyph.
    #
    # The value field is 6 wide, not 5: after the unit division above, b can be
    # up to 1023.9, which needs 6 characters. A 5-wide field would silently
    # widen to 6 for values in [1000, 1024) and shift the whole bar — the exact
    # bug this function exists to prevent.
    #
    # One decimal throughout (rather than a 0/1/2-decimal spread by magnitude)
    # keeps the digits themselves stable as traffic crosses unit boundaries.
    awk -v b="$1" -v g="$2" 'BEGIN {
        split("B KiB MiB GiB TiB", u, " ");
        i = 1;
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf "%s %6.1f %-3s", g, b, u[i];
    }'
}

down=$(( rx2 - rx1 ))
up=$(( tx2 - tx1 ))
# Counters can wrap/reset (interface flap); clamp instead of printing negatives.
[ "$down" -lt 0 ] && down=0
[ "$up" -lt 0 ] && up=0

# Below ~1 KiB/s show a quiet zero readout rather than "idle", so the module
# keeps the same width when nothing is happening. A dashed placeholder would be
# narrower and would shift the bar on every idle/active transition.
printf '%s  %s\n' "$(human "$down" "v")" "$(human "$up" "^")"
