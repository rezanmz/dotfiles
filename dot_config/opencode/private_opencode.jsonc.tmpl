{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": {{ if eq .machine "work" }}false{{ else }}{{ .enableNetworkMCP | default false }}{{ end }},
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": {{ if eq .machine "work" }}false{{ else }}{{ .enableNetworkMCP | default false }}{{ end }}
    }
  },
  "permission": {
    "websearch": "{{ if eq .machine "work" }}deny{{ else }}allow{{ end }}",
    "webfetch": "{{ if eq .machine "work" }}deny{{ else }}allow{{ end }}"
  },
  // Model traffic falls back through 9Router (chat/smart combos).
  // The API key lives in ~/.local/share/opencode/auth.json (never in this
  // public repo); authenticate with `opencode auth login` for provider
  // 9router or write the auth.json entry manually.
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "https://router.reza.network/v1"
      },
      "models": {
        "chat": { "name": "chat" },
        "smart": { "name": "smart" }
      }
    },
    "test": {
      "name": "test",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://router.reza.network/v1"
      },
      "models": {
        "chat": {
          "name": "Chat"
        },
        "smart": {
          "name": "Smart"
        }
      }
    }
  },
  "lsp": true,
  "plugin": [
    "oh-my-opencode-slim@2.2.15"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "disabled_providers": []
}
