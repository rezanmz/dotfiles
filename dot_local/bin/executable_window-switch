#!/bin/sh
# Window switcher: list Hyprland windows with rofi and focus the chosen one.
# Bound to SUPER+SHIFT+T.
#
# Two choices worth keeping in sync with the code below:
#
#   -format i
#       rofi prints the row INDEX, not the row text, so the window address is
#       never shown — rows read "class — title" instead of leaking a 0x address
#       — and selection maps the index back to a freshly-read client list.
#       That is also why stale rows are safe: if a window closed while the
#       picker was open, the bounds check at the bottom does nothing rather
#       than focusing the wrong window.
#
set -eu

# Index -> window address, resolved at selection time so a closing window can
# not shift rows underneath the cursor.
resolve_index='
import json, sys
try:
    idx = int(sys.argv[1])
    clients = [c for c in json.load(sys.stdin)
               if c.get("mapped", True)
               and ((c.get("title") or "").strip() or (c.get("class") or "").strip())]
    if 0 <= idx < len(clients):
        print(clients[idx]["address"])
except Exception:
    pass
'

# One row per window: class, an em dash, then the title (truncated).
list_windows='
import json, sys
for c in json.load(sys.stdin):
    if not c.get("mapped", True):
        continue
    title = (c.get("title") or "").strip()
    cls = (c.get("class") or "").strip()
    if not title and not cls:
        continue
    print(cls + "  —  " + title[:80])
'

# -format i makes rofi print the row INDEX rather than the row text, which is
# what fuzzel's dmenu.mode=index used to do. The index is resolved back to a
# freshly-read client list below, so a window closing while the picker is open
# cannot make the selection land on the wrong window.
choice=$(hyprctl clients -j | python3 -c "$list_windows" |
    rofi -dmenu -i -format i -p 'win❯ ' -l 10 \
        -theme-str 'window {width: 50%;}' -theme-str 'entry {placeholder: "Switch window";}') || exit 0

[ -n "$choice" ] || exit 0

addr=$(hyprctl clients -j | python3 -c "$resolve_index" "$choice")
[ -n "$addr" ] || exit 0

hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
