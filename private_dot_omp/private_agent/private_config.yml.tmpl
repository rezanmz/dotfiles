providers:
  webSearchOrder:
    - ecosia
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - duckduckgo
    - google
    - mojeek
    - public
modelRoles:
{{ if eq .machine "work" }}
  default: github-copilot/gpt-5.6-sol:xhigh
  slow: github-copilot/claude-opus-5:max
  smol: github-copilot/gemini-3.7-flash
  vision: github-copilot/claude-sonnet-5:high
  plan: github-copilot/claude-opus-5:max
  designer: github-copilot/claude-sonnet-5:high
  commit: github-copilot/gpt-5.6-luna:low
  tiny: github-copilot/gpt-5.6-luna:minimal
  task: github-copilot/gpt-5.6-sol
  advisor: github-copilot/grok-4.6:high
{{ else }}
  default: opencode-go/gpt-5.6-luna:high
  slow: opencode-go/kimi-k3:max
  smol: opencode-go/deepseek-v4-flash
  vision: opencode-go/gpt-5.6-luna:high
  plan: opencode-go/kimi-k3:max
  designer: opencode-go/gpt-5.6-luna:high
  commit: opencode-go/deepseek-v4-flash:low
  tiny: opencode-go/deepseek-v4-flash:minimal
  task: opencode-go/gpt-5.6-luna:high
  advisor: opencode-go/gpt-5.6-luna:high
{{ end }}
advisor:
  enabled: true
task:
  eager: preferred
  batch: true
  maxConcurrency: {{ if eq .machine "work" }}8{{ else }}4{{ end }}
  maxRecursionDepth: {{ if eq .machine "work" }}2{{ else }}1{{ end }}
  softRequestBudget: {{ if eq .machine "work" }}200{{ else }}100{{ end }}
  enableEffort: true
  enableLsp: true
  showResolvedModelBadge: true
  isolation:
    mode: auto
    apply: true
    merge: patch
  agentModelOverrides:
    security-reviewer: "@slow"
retry:
  enabled: true
  modelFallback: true
  usageAwareFallback: false
  fallbackChains:
{{ if eq .machine "work" }}
    default:
      - github-copilot/grok-4.6:high
      - github-copilot/gpt-5.6-terra:high
    slow:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-4.8:high
    plan:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-4.8:high
    smol:
      - github-copilot/gpt-5.6-luna
      - github-copilot/mai-code-1.1-flash
    task:
      - github-copilot/gpt-5.3-codex:high
      - github-copilot/grok-4.6:high
    vision:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    designer:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    commit:
      - github-copilot/mai-code-1.1-flash
    tiny:
      - github-copilot/mai-code-1.1-flash
    advisor:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gpt-5.6-terra:high
{{ else }}
    default:
      - opencode-go/gpt-5.6-luna:high
    slow:
      - opencode-go/gpt-5.6-luna:high
    plan:
      - opencode-go/gpt-5.6-luna:high
    smol:
      - opencode-go/gpt-5.6-luna:medium
    task:
      - opencode-go/gpt-5.6-luna:high
    vision:
      - opencode-go/deepseek-v4-flash-vision-exp:high
    designer:
      - opencode-go/deepseek-v4-flash-vision-exp:high
    commit:
      - opencode-go/gpt-5.6-luna:low
    tiny:
      - opencode-go/gpt-5.6-luna:low
    advisor:
      - opencode-go/deepseek-v4-flash:high
{{ end }}
symbolPreset: unicode
theme:
  dark: titanium
  light: light
setupVersion: 2
dev:
  autoqaConsent: granted
composer:
  shape: box
defaultThinkingLevel: auto