#!/bin/sh
# Swift 1.5 Qwen3.8-27B (GSQ-RCO IQ3_XXS-mtp) on RX 9070 XT 16 GB + 30 GB RAM.
#
# Measured 2026-11-03, llama.cpp b12079, Vulkan/RADV:
#   CTX=98304  plain : prefill 742 t/s, decode 38 t/s @48K depth, 13.8 GiB VRAM (2.5 GiB free)
#   CTX=98304  MTP=1 : prefill 711 t/s, decode 55 t/s @48K depth, 15.0 GiB VRAM (1.3 GiB free)
#   CTX=131072 plain : 31.8 t/s decode @128K depth, 14.3 GiB VRAM (1.9 GiB free)
#   CTX=262144       : does not fit; -nkvo workaround decodes at 6 t/s -> unusable
#   -nkvo (KV in RAM): 6 t/s at 48K depth. Also incompatible with MTP (GGML_ASSERT at load).
#
# Env: CTX (default 98304), MTP=1 (+45% decode, +1.3 GiB VRAM),
#      EFFORT (low|medium|xhigh|none, default low - "none" burns ~5x the tokens), PORT (8080)
set -e
LLAMA=${LLAMA_DIR:-$HOME/.local/opt/llama-b12079}
MODEL=${MODEL:-$HOME/models/swift15/IQ3_XXS-mtp.gguf}
CTX=${CTX:-98304}
PORT=${PORT:-8080}
EFFORT=${EFFORT:-low}

mtp=""
if [ "${MTP:-0}" = "1" ]; then
  mtp="--spec-type draft-mtp"
fi

kw=""
if [ "$EFFORT" != "none" ]; then
  kw="--chat-template-kwargs {\"reasoning_effort\":\"$EFFORT\"}"
fi

exec "$LLAMA/llama-server" \
  -m "$MODEL" \
  -c "$CTX" -ngl 99 -fa on -ctk q4_0 -ctv q4_0 \
  -ub 256 -b 512 -t 8 --parallel 1 --jinja \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
  --presence-penalty 0.0 --repeat-penalty 1.0 \
  --host 127.0.0.1 --port "$PORT" $mtp $kw
