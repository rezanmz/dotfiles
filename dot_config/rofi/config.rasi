/* rofi configuration — one unified menu for the whole session.
 *
 * SUPER+SPACE opens `combi`, which merges four modes into a single prompt:
 *
 *   calc     arithmetic, evaluated live as you type (rofi-calc)
 *   drun     applications, from the XDG desktop entries
 *   window   already-open windows
 *   session  lock / suspend / log out / reboot / power off
 *
 * Type an expression and the answer appears; type an app name and it launches;
 * type "reboot" and you get the action. That is the Spotlight behaviour.
 *
 * Everything lives in this ONE file rather than splitting a theme out and
 * @import-ing it: a broken import makes rofi exit silently with no window and
 * no error, which is a bad failure mode for the thing that launches apps.
 *
 * Colours mirror dot_config/fuzzel/fuzzel.ini (Dracula) so the menu matches
 * the rest of the desktop.
 */

configuration {
    /* The rofi-calc plugin cannot work in combi — upstream issue #33, open
     * since 2019 — it shows only "Add to history" and never the result. So the
     * `calc` mode here is a small script mode instead (rofi-math), which does
     * work in combi and is what makes one unified menu possible.
     *
     * Script modes use the name:command form; built-in modes are bare names. */
    /* The name must NOT be "calc": libcalc.so registers a mode called calc
     * globally, and a script mode with the same name is shadowed by the
     * plugin (which is why the plugin's "Add to history" row appeared instead
     * of our result). Hence `math` for the script. */
    modi: "calc,drun,window,session:/home/reza/.local/bin/rofi-session,calc-entry:/home/reza/.local/bin/rofi-calc-entry";
    combi-modes: "drun,window,session,calc-entry";

    /* Hide the per-row mode prefix ("calc ", "drun ") — the icon already says
     * which is which, and the prefix just adds noise to every line. */
    combi-hide-mode-prefix: true;

    /* rofi-calc draws its Result row with Pango markup (<b>, colour tags).
     * Without this the tags are not parsed and the answer renders at a
     * contrast ratio of ~1.06:1 against the background — literally
     * invisible. Measured, not guessed: background (39,41,54), result
     * text (0,43,54). */
    markup-rows: true;
    show-icons: true;
    icon-theme: "Papirus";

    /* Long app names and window titles must not push the window around. */
    fixed-num-lines: true;
    lines: 10;

    /* Dismiss on Escape or clicking away. */
    click-to-exit: true;
    steal-focus: true;

    /* Case-insensitive matching, and match on more than the display name so
     * "browser" finds Chrome and "mail" finds Thunderbird. */
    case-sensitive: false;
    drun-match-fields: "name,generic,exec,categories,keywords";
    drun-display-format: "{name}";

    /* Launch Terminal=true entries in kitty. */
    terminal: "kitty";

    /* Keep the most-used apps at the top; cache lives in ~/.cache/rofi. */
    drun-use-frecency: true;
}

* {
    /* Dracula, matching 00-theme.lua and the terminal themes. */
    bg:      #282a36f7;
    fg:      #f8f8f2ff;
    purple:  #bd93f9ff;
    cyan:    #8be9fdff;
    green:   #50fa7bff;
    red:     #ff5555ff;
    comment: #6272a4ff;

    background-color: transparent;
    text-color:       @fg;
    font:             "Hack Nerd Font Mono 13";
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @purple;
    border-radius:    14px;
    width:            46%;
    padding:          18px;
}

/* The query line. */
inputbar {
    children:   [ prompt, entry ];
    background-color: transparent;
    padding:    4px 0 10px 0;
    spacing:    8px;
}

prompt {
    /* Muted, so what you typed is the brightest thing on screen. */
    text-color: @comment;
    padding:    0 4px 0 0;
}

entry {
    text-color: @fg;
    placeholder: "Search apps, do maths, run a session action";
    placeholder-color: @comment;
}

/* rofi-calc renders the computed answer in a TEXTBOX above the list — not a
 * list row, and not the `message` element either. Styling element-text or
 * message therefore does nothing for it, which is what made this look like a
 * rofi bug. Found by testing each candidate selector and measuring which one
 * produced coloured pixels in the result band: only `textbox` did.
 *
 * Without this it renders rgb(0,43,54) on rgb(88,104,117) — about 2.5:1
 * contrast, i.e. barely readable. */
textbox {
    text-color:       @green;
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns:    1;
    lines:      10;
    spacing:    4px;
    scrollbar:  true;
    padding:    6px 0 0 0;
}

scrollbar {
    handle-width: 6px;
    handle-color: @purple;
    background-color: transparent;
}

element {
    padding:        7px 10px;
    border-radius:  10px;
    spacing:        12px;
}

element-icon {
    size:            22px;
    background-color: transparent;
}

element-text {
    /* No text-color here on purpose. rofi-calc colours its Result row via
     * markup; forcing a colour on every element-text overrides that and
     * flattens the answer to ~1.1:1 contrast (measured) — i.e. invisible. */
    vertical-align:  0.5;
}

/* Selection: soft purple wash rather than flat grey, text stays bright. */
element.selected {
    background-color: #bd93f9a6;
}

element.selected element-text {
    text-color: @fg;
}

/* rofi-calc renders the computed answer in this element. Give it the accent
 * colour so it reads as the important line it is. */
element-text.urgent {
    text-color: @cyan;
}

element.urgent {
    background-color: #ff5555a6;
}

/* The mode hint rofi shows on the right of a row. */
element-text.highlight {
    text-color: @green;
}

/* "Add to history" / mode rows in the calc view. */
element normal.normal {
    background-color: transparent;
    text-color:      @fg;
}
