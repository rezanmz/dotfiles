#!/bin/sh
# Sorjîn2.1-12B-Instruct — Kurdish Kurmanji (Latin script), Gemma-4-12B-it based.
# mradermacher/Sorjin2.1-12B-Instruct-GGUF, Q5_K_M (7.96 GiB), RX 9070 XT 16 GB.
#
# Measured 2026-11-11 (llama.cpp build 12284 ROCm, 96K ctx, q4_0 KV, ub 1024):
#   96K ctx VRAM ...................................... 11.64 GiB (4.6 GiB left for the desktop)
#   32K ctx VRAM ...................................... 11.17 GiB
#   prefill, 9.0K-token prompt ........................ 5.70 s   (~1585 t/s blended)
#   decode ............................................ ~64 t/s
#   model load to listening ........................... ~4 s (mmap + page cache)
#
# THINKING IS OFF BY DEFAULT on purpose. The publisher says the instruction tuning was
# done "without thinking: every training prompt ends with the template's empty thinking
# block" (model card, `muzaffercky/Sorjin2.1-12B-Instruct`). With thinking left on,
# llama-server emits a long English reasoning trace that re-translates the question before
# answering, and the answer arrives late or truncated at the token limit. THINK=1 turns it
# back on; it is useful for translation work, not for chat.
#
# Known behaviours, from the model card (not measured here):
#   * greedy decoding can loop on one phrase until the token limit -- hence sampling below
#     (temp 1.0 / top_p 0.95 / top_k 64 are the publisher's own recommended settings);
#   * answers come in web/thesis register: long run-on paragraphs, not assistant replies.
#
# Env: CTX (98304), PORT (8080), MODEL, LLAMA_DIR, TEMPLATE, THINK (0), NGL (99)
set -e
LLAMA=${LLAMA_DIR:-$HOME/.unsloth/llama.cpp/build/bin}
MODEL=${MODEL:-$HOME/models/sorjin2.1/Sorjin2.1-12B-Instruct.Q5_K_M.gguf}
TEMPLATE=${TEMPLATE:-$HOME/models/sorjin2.1/chat-template.jinja}
CTX=${CTX:-98304}
PORT=${PORT:-8080}
NGL=${NGL:-99}

# Never start on a busy port: llama-server would die with "HTTP server error" while
# clients silently talk to the stale process (already happened once).
if command -v ss >/dev/null 2>&1 && ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
  echo "sorjin21: port $PORT is already in use -- another server is running." >&2
  echo "          reuse it, pick another port (PORT=8081 sorjin21), or stop it: pkill -f llama-server" >&2
  exit 1
fi

tmpl=""
[ -f "$TEMPLATE" ] && tmpl="--chat-template-file $TEMPLATE"

# 0 = off (faithful to training), 1 = on.
if [ "${THINK:-0}" = "1" ]; then rea="--reasoning on"; else rea="--reasoning off"; fi

# HIP_VISIBLE_DEVICES pins to the discrete card. Without it llama.cpp also sees the
# Raphael iGPU, which advertises ~15.6 GiB of *shared system RAM* and would silently
# overflow a 12B model into main memory.
HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-0}
export HIP_VISIBLE_DEVICES

exec "$LLAMA/llama-server" \
  -m "$MODEL" \
  -c "$CTX" -ngl "$NGL" -fa on -ctk q4_0 -ctv q4_0 \
  -ub 1024 -b 2048 -t 8 --parallel 1 --cache-ram 16384 --jinja $tmpl $rea \
  --temp 1.0 --top-p 0.95 --top-k 64 --min-p 0.0 \
  --presence-penalty 0.0 --repeat-penalty 1.0 \
  --host 127.0.0.1 --port "$PORT"
