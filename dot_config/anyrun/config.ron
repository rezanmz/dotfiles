// anyrun configuration — replaces rofi (and fuzzel before it).
//
// Managed by chezmoi: source lives in ~/.local/share/chezmoi/dot_config/anyrun.
//
// anyrun reads config.ron and style.css from its config directory, and each
// plugin reads its own <plugin>.ron from the same directory. Plugin paths in
// `plugins` may be bare library names, resolved against anyrun's plugin
// directory, or absolute paths.
//
// Plugin order defines result priority: applications, then the power actions,
// then the calculator. Actions sit above the calculator so that typing "lock"
// or "reboot" reaches them without having to out-rank a mathematical reading of
// the same words.

/*
 * Geometry
 * ========
 *
 * Two things anyrun's layout does here, both learned by measuring a live run
 * rather than reading the code, because neither is obvious:
 *
 * 1. VERTICAL POSITION IS TOP-ANCHORED, NOT CENTRED.
 *
 *    app.rs anchors the layer surface to the top and left edges, then places
 *    the card with fixed margins computed as
 *
 *        margin_top = y - height/2      margin_bottom = mon_height - margin_top - height
 *
 *    With y: Fraction(0.5) and height: Absolute(1) that is margin_top = 864 and
 *    margin_bottom = 863 on a 1728px screen. The card is then laid out inside
 *    those margins with `height: 1px` of allowance, so it takes its natural
 *    height and grows DOWNWARD from y=864 — it is not recentred as the results
 *    change.
 *
 *    The practical consequence: the box top edge is set by a computed margin and
 *    the list grows down from there. Hence the derived `y` below rather than a
 *    naive 0.5 — that field's own comment has the arithmetic.
 *
 * 2. THERE IS NO SCROLLING, UPSTREAM.
 *
 *    anyrun contains no ScrolledWindow (checked in source: neither app.rs nor
 *    plugin_box.rs creates one). This is a known upstream gap, not a setting:
 *
 *      #29  "Support for scrollable menu?"            open
 *      #114 "Bug: Can't show all items correctly"     open
 *      #319 "feat: mouse scrolling"                   open PR, unmerged
 *
 *    PR #319 is the fix, and it is not merged — the `min_results_height` /
 *    `max_results_height` options it adds are absent from both v26.6.1 and
 *    current master. It also only covers the mouse wheel.
 *
 *    So with no cap the list simply runs off the bottom of the screen and the
 *    rows past the edge cannot be reached at all. The cap below is the
 *    workaround: rows past it are reached by narrowing the query, which is the
 *    normal way to use a launcher.
 */

Config(
    // Centred horizontally, which is rofi's own default.
    x: Fraction(0.5),

    /*
     * Centred — and the value is derived, not guessed.
     *
     * The card is a FIXED-height frame (see style.css: GTK4 has min-height but
     * no max-height, so pinning min-height to the tallest possible content is
     * what stops it resizing and jumping). Because the height is now known and
     * constant, the offset that centres it can be computed exactly:
     *
     *     wanted top edge = (usable height - card height) / 2
     *                     = (1728 - 560) / 2 = 584px
     *
     * and anyrun's own formula is  margin_top = y * monitor_height - height / 2,
     * where `height` is THIS field, not the card's rendered height. Solving:
     *
     *     y = (584 + 44/2) / 1728 = 0.351
     *
     * 0.351 rather than 0.5 because of that -height/2 term: passing 0.5 would
     * place the top edge at 864 - 22 = 842px, i.e. 258px below centre.
     *
     * 0.319, not 0.351: the formula above assumes the layer surface starts at
     * y=0, but it actually starts below the waybar's 44px exclusive zone, so the
     * computed 0.351 rendered the card with its midpoint 69px BELOW the screen
     * midpoint (measured live: card top 770, bottom 1528, midpoint 1149 vs 1080).
     * Subtracting that offset in the same units gives 0.351 - 69/2160 = 0.319,
     * which is what is used here.
     *
     * If the fixed height in style.css or the waybar reserve changes, this number
     * must be recomputed — see that file's min-height comment.
     */
    y: Fraction(0.319),

    /*
     * Width: 0.30 of 3072 = 921px.
     *
     * Walked down twice on feedback: 0.46 matched the old rofi window (1413px),
     * then 0.38 (1167px), and both read as too wide. 921px is comfortably under
     * a thousand and still fits a long application name beside its plugin label
     * — "Avahi Zeroconf Browser" plus "Applications" measures about 640px at
     * this font size, so there is room to spare on the widest realistic row.
     */
    width: Fraction(0.30),

    /*
     * Minimum height, in pixels, of the card.
     *
     * Small but not 1: the value is a floor, and the card still grows with its
     * content. Raising it from 1 removes the hairline-height flash on the first
     * frame and gives the input line some body before results arrive.
     */
    height: Absolute(44),

    // Keep the Nerd Font plugin icons; they are what makes the rows scannable.
    hide_icons: false,
    hide_plugin_info: false,

    /*
     * Respect the exclusive zone. This MUST stay false.
     *
     * Waybar reserves 44px at the top of this monitor (`reserved=[0, 44, 0, 0]`)
     * and rofi honoured that. With `true` anyrun is free to draw over the bar,
     * and because its click-outside-to-close surface spans the monitor, that
     * surface would swallow clicks on the bar. `false` keeps the runner inside
     * the usable area.
     */
    ignore_exclusive_zones: false,

    layer: Overlay,

    // Click outside the card to close, as rofi did.
    close_on_click: true,

    /*
     * Nothing is shown until something is typed.
     *
     * `true` was tried in an attempt to avoid opening onto an empty box, and it
     * made things worse rather than better: with an empty query no plugin has
     * anything meaningful to offer, so the list filled with the symbols plugin's
     * entire table — "SPACE", "!", "QUOTATION MARK" — which is noise, not
     * results. (Symbols now has a ";" prefix, so it stays quiet either way, but
     * the setting is still not worth having.)
     */
    show_results_immediately: false,

    /*
     * Hard cap on rows shown at once.
     *
     * This is the overflow fix — see the header comment. anyrun cannot scroll,
     * so an uncapped list runs off the bottom of the screen.
     *
     * Eight rather than ten: the card is a fixed-height frame (see style.css),
     * so every slot costs permanent blank space when a query returns fewer rows.
     * Eight is the smallest cap that still shows a whole plugin's worth of
     * results without scrolling, and it keeps the frame short. Narrowing the
     * query is how you reach anything past the cap.
     */
    max_entries: Some(8),

    /*
     * Plugin order = priority. Applications first so an app name is never beaten
     * by a calculator reading of it; actions above rink so "reboot" and "lock"
     * reach the power menu.
     */
    plugins: [
        "libapplications.so",
        "libactions.so",
        "librink.so",
        "libshell.so",
        "libsymbols.so",
        "libwebsearch.so",
    ],

    keybinds: [
        Keybind(
            key: "Return",
            action: Select,
        ),
        Keybind(
            key: "Up",
            action: Up,
        ),
        Keybind(
            key: "Down",
            action: Down,
        ),
        Keybind(
            key: "ISO_Left_Tab",
            action: Up,
            shift: true,
        ),
        Keybind(
            key: "Tab",
            action: Down,
        ),
        Keybind(
            key: "Escape",
            action: Close,
        ),
    ],
)
