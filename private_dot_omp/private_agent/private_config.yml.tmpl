modelRoles:
{{- if eq .machine "work" }}
  default: github-copilot/gpt-6.1-sol:xhigh
  slow: github-copilot/claude-opus-5.5:max
  smol: github-copilot/claude-haiku-5.5:medium
  vision: github-copilot/gpt-6.1-sol:high
  plan: github-copilot/claude-sonnet-5.5:xhigh
  designer: github-copilot/claude-sonnet-5.5:high
  commit: github-copilot/gpt-6-luna:low
  tiny: github-copilot/gpt-6-luna:low
  task: github-copilot/gpt-6.1-sol:medium
  advisor: github-copilot/claude-sonnet-5.5:xhigh
{{- else }}
  # Roles point at individual opencode-go SOURCE models routed through the
  # self-hosted 9Router (ids are `ocg/<slug>` — the prefix is mandatory; see
  # models.yml). Picks are headroom-first: the monthly Go allowance is a
  # DOLLAR bucket, so each primary is the best intelligence-per-dollar that
  # still has room, and no two hot roles share a bucket.
  #   default  minimax-m3.1-flash-free  II 42.0  FREE + UNLIMITED (limited-time promo)
  #   task     minimax-m3.1-flash-free  II 42.0  FREE + UNLIMITED (limited-time promo)
  #   slow/plan/advisor  mimo-v2.6-pro  II 46.3  $15 bucket  113 units
  #   vision/designer  glm-5.3-flash  II 41.8  $60 bucket  212 units  image+video+pdf
  #   smol/commit  mimo-v2.6-flash  II 37.9  $60 bucket  962 units
  #   tiny  beam-free  II 30.3  free+unlimited, 228 tok/s
  # default/task sit on the free M3.1 Flash lane because it is the one model
  # that consumes NO dollar bucket: measured 45-75 TPS through the router vs
  # ~106 for deepseek-v4.1-flash, and verbose, but free and it out-scores what
  # it replaced (AA-index 42 vs 39.5). The promo can end without notice, so
  # both roles keep deepseek-v4.1-flash at the head of the fallback chain —
  # reverting is then just the primary line.
  default: 9router/ocg/minimax-m3.1-flash-free:high
  slow: 9router/ocg/mimo-v2.6-pro:xhigh
  smol: 9router/ocg/mimo-v2.6-flash:minimal
  vision: 9router/ocg/glm-5.3-flash:high
  plan: 9router/ocg/mimo-v2.6-pro:xhigh
  designer: 9router/ocg/glm-5.3-flash:high
  commit: 9router/ocg/mimo-v2.6-flash:minimal
  tiny: 9router/ocg/beam-free
  task: 9router/ocg/minimax-m3.1-flash-free:high
  # Advisor: mimo-v2.6-pro (user preference). The cost win comes from cadence
  # and context shape, not the model: one review per completed run, no
  # investigative tools, two notes max, blocker-only wakeups. Measured review
  # size on the previous model: 1 request, 2-12k input tokens per run.
  advisor: 9router/ocg/mimo-v2.6-pro:xhigh
  # Judge: `~typesafe/jev-latest` through OpenRouter's Decisions API
  # (POST https://openrouter.ai/api/alpha/decisions, input-only billing at
  # $0.042/M): ~$0.0001 per `find` cascade, ~$0.00002 per auto-thinking
  # classification. The alias rides whatever Jev build OpenRouter marks stable,
  # instead of a pinned build; Cloudflare Clef answers text judgments when Jev
  # is unavailable. Both are native judges because `find.enabled: auto` turns
  # the find tool off when this role resolves to a chat/tiny model, and a native
  # failure never degrades to a prompted judge. Box questions (`judge(..., box)`)
  # need Jev 1.14+, so they follow the alias and will not reach Clef.
  judge: openrouter/~typesafe/jev-latest
{{- end }}
advisor:
  # Cost control, not removal. The previous setup reviewed EVERY tool round
  # with TWO advisors (reviewMode: turn x 2), which is why usage roughly
  # doubled. Now: one reviewer, once per completed run, two notes max, and only
  # blockers may wake the primary. It keeps read/grep/glob so it can check a
  # claim against the repo; cadence is what bounds the cost.
  enabled: true
  reviewMode: agent-end
  reviewInterval: 1
  maxNotesPerUpdate: 2
  continueSeverity: blocker
  evictStaleResults: true
  syncBacklog: off
task:
  eager: preferred
  batch: true
  maxConcurrency: {{ if eq .machine "work" }}8{{ else }}4{{ end }}
  # Depth 2: a child may spawn one level of its own workers. Leaves are agents
  # whose tool list omits `task` (e.g. verifier), so fan-out stays deliberate.
  maxRecursionDepth: 2
  softRequestBudget: {{ if eq .machine "work" }}200{{ else }}100{{ end }}
  enableEffort: true
  enableLsp: true
  showResolvedModelBadge: true
  isolation:
    apply: true
    merge: patch
    enabled: true
  agentModelOverrides:
    security-reviewer: "@slow"
retry:
  enabled: true
  modelFallback: true
  usageAwareFallback: false
  fallbackChains:
{{- if eq .machine "work" }}
    # Each chain starts with the role's previous primary, then a
    # cross-vendor alternative.
    default:
      - github-copilot/gpt-5.6-terra:high
      - github-copilot/claude-sonnet-5.5:xhigh
    slow:
      - github-copilot/claude-opus-5:max
      - github-copilot/gpt-6.1-sol:max
    plan:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-5.5:high
    smol:
      - github-copilot/gemini-3.7-flash:low
      - github-copilot/gpt-6-luna:medium
    task:
      - github-copilot/gpt-5.6-terra:high
      - github-copilot/claude-sonnet-5.5:high
    vision:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gemini-3.8-flash:high
    designer:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gpt-6.1-sol:high
    commit:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash
    tiny:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash
    advisor:
      - github-copilot/grok-4.6:high
      - github-copilot/gpt-6.1-sol:high
{{- else }}
    # Each chain is (a) a cooler/cheaper model on the SAME 9Router lane, then
    # (b) the OpenRouter twin of the primary. The trailing `openrouter/*`
    # entry keeps the failing model's id and swaps only the provider, so it
    # covers that provider as a last resort; specific twins are listed where
    # the slug differs.
    #
    # NOTE: every `opencode-go/*` entry in the previous chains was DEAD — this
    # machine resolves no such provider (only `9router`), so those entries
    # failed silently and the chain fell through to nothing. All fallbacks now
    # live under `9router` (same vendor, second account) or `openrouter`.
    default:
      - 9router/ocg/deepseek-v4.1-flash:high
      - 9router/ocg/glm-5.3-flash:high
      - 9router/ocg/mimo-v2.6-flash:high
      - openrouter/deepseek/deepseek-v4.1-flash:high
    slow:
      - 9router/ocg/glm-5.3-flash:xhigh
      - 9router/ocg/muse-spark-1.3-contributor:xhigh
      - openrouter/xiaomi/mimo-v2.6-pro:xhigh
      - openrouter/deepseek/deepseek-v4.1-flash:max
    plan:
      - 9router/ocg/glm-5.3-flash:xhigh
      - 9router/ocg/muse-spark-1.3-contributor:xhigh
      - openrouter/xiaomi/mimo-v2.6-pro:xhigh
      - openrouter/deepseek/deepseek-v4.1-flash:max
    smol:
      - 9router/ocg/gpt-6-luna:minimal
      - 9router/ocg/hy3:minimal
      - openrouter/xiaomi/mimo-v2.6-flash:minimal
      - openrouter/qwen/qwen3.8-flash:minimal
    task:
      - 9router/ocg/deepseek-v4.1-flash:high
      - 9router/ocg/mimo-v2.6-pro:high
      - openrouter/xiaomi/mimo-v2.6-pro:high
      - openrouter/z-ai/glm-5.3-flash:high
    vision:
      - 9router/ocg/deepseek-v4.1-flash:high
      - 9router/ocg/mimo-v2.6-pro:high
      - openrouter/z-ai/glm-5.3-flash:high
      - openrouter/xiaomi/mimo-v2.6-pro:high
    designer:
      - 9router/ocg/deepseek-v4.1-flash:high
      - 9router/ocg/mimo-v2.6-pro:high
      - openrouter/z-ai/glm-5.3-flash:high
      - openrouter/xiaomi/mimo-v2.6-pro:high
    commit:
      - 9router/ocg/gpt-6-luna:minimal
      - 9router/ocg/hy3:minimal
      - openrouter/xiaomi/mimo-v2.6-flash:minimal
      - openrouter/qwen/qwen3.8-flash:minimal
    tiny:
      - 9router/ocg/mimo-v2.6-flash:minimal
      - 9router/ocg/hy3:minimal
      - openrouter/xiaomi/mimo-v2.6-flash:minimal
      - openrouter/qwen/qwen3.8-flash:minimal
    advisor:
      - 9router/ocg/glm-5.3-flash:xhigh
      - 9router/ocg/muse-spark-1.3-contributor:xhigh
      - openrouter/xiaomi/mimo-v2.6-pro:xhigh
      - openrouter/deepseek/deepseek-v4.1-flash:max
    judge:
      # Natives only. After the first native candidate the judge chain stops at
      # other native judges, so a chat entry here would never be reached.
      # Clef answers text judgments only (no images, 64-question cap).
      - openrouter/cloudflare/clef
{{- end }}
symbolPreset: nerd
theme:
  dark: titanium
  light: light
setupVersion: 2
dev:
  autoqaConsent: granted
composer:
  shape: box
defaultThinkingLevel: auto
isolation:
  backend: auto
memory:
  # Personal machines use the Hindsight bank (first-turn auto-recall,
  # auto-retain every 3 turns, mental models). Work machines stay local.
  # This mirrors the shared-memory MCP split in mcp.json: the bank is
  # personal-stack only, so both halves of the memory story agree per machine.
{{- if eq .machine "work" }}
  backend: local
{{- else }}
  backend: hindsight
{{- end }}
autolearn:
  # Exposes the `learn` tool on both backends: local appends to the project's
  # learned.md; hindsight queues a retain.
  enabled: true
{{- if ne .machine "work" }}
hindsight:
  apiUrl: https://memory.reza.network
  # Token is NOT set here: omp does not expand ${VAR} inside config values
  # (the literal string is sent as the bearer and every call 401s). The
  # setting's own env binding applies instead: HINDSIGHT_API_TOKEN in
  # ~/.omp/agent/.env, which omp loads into the process environment.
  bankId: shared
  scoping: per-project-tagged
  recallTimeoutMs: 30000
  retainMode: full-session
{{- end }}
bash:
  # Deny-only guardrails on top of approvalMode: yolo. `deny` (not `prompt`)
  # because a prompt cannot be answered in print/headless runs; a denial
  # returns a reason the model can adapt to. First matching rule wins, so the
  # --force-with-lease allow must precede the broader --force deny. These
  # cover literal commands only; the pre/00-guardrails hook covers eval and
  # flag-order variants. Neither is containment.
  patterns:
    - match: "git push --force-with-lease*"
      approval: allow
    - match: "git push --force*"
      approval: deny
    - match: "git push -f*"
      approval: deny
    - match: "git push * -f*"
      approval: deny
    - match: "curl * | sh*"
      approval: deny
    - match: "curl * | bash*"
      approval: deny
    - match: "wget * | sh*"
      approval: deny
    - match: "wget * | bash*"
      approval: deny
    - match: "dd * of=/dev/*"
      approval: deny
    - match: "mkfs*"
      approval: deny
    - match: "diskutil erase*"
      approval: deny
lsp:
  # Surface type/lint errors as soon as an edit lands, not only on write.
  diagnosticsOnEdit: true
checkpoint:
  # Conversation-only context checkpoint (pairs with `rewind`). It does NOT
  # restore files; refs/omp-snapshots from the session-start hook is the
  # file-level undo.
  enabled: true
secrets:
  enabled: true
compaction:
  # Upstream default is false. Enabling it silently rewrites the live
  # session's model context 5 minutes after you stop typing whenever the
  # context is above idleThresholdTokens (200k) — far below the ~850k
  # normal auto-compaction threshold on a 1M window — so walking away
  # from a mid-size session destroys the conversation the model sees.
  idleEnabled: false
  handoffSaveToDisk: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
terminal:
  showProgress: true
statusLine:
  preset: custom
  leftSegments:
    - model
    - mode
    - path
    - git
    - pr
  rightSegments:
    - context_pct
    - token_total
    - cost
    - time_spent
    - subagents
    - status