#!/bin/sh
# llm — one command per model hosted on this machine. Declarative: one .conf per model, no code per model.
#
#   llm                    what is declared, where it came from, what is on disk, what is running
#   llm <name>             run it in the FOREGROUND; Ctrl+C (or closing the window) stops it.
#                          Missing files are downloaded first when the recipe says where they come from.
#   llm <name> --print     print the exact command, change nothing
#   llm fetch <name>       only download what the recipe needs (resumable)
#   llm prune <name>       delete this recipe's model files (prints the total; add --yes to do it)
#   llm new <name>         scaffold a recipe, then fill in two lines
#   llm stop               stop whatever is serving the port
#   llm help
#
# Starting a model also rewrites the one shared omp profile, ~/.omp/profiles/offline, to point at it: after
# `llm huihui27` you talk to it with `omp --profile offline`, and after `llm sc117` the same command talks to that.
#
# A recipe is ~/.local/share/llm/recipes/<name>.conf (a shell file, so $HOME works):
#
#   about="what it is, in one line"      # shown by `llm list`
#   engine=llama                         # llama | strata | qev (a System One decision server; see joey1.conf)
#   model=$HOME/models/x/model.gguf      # llama: a .gguf; strata: the shard folder
#   ctx=32768                            # llama: -c; strata: --max-context
#   kv=q4_0                              # llama: -ctk/-ctv; strata: --kv
#   llama_dir=$HOME/.local/opt/llama-b12079   (llama) where llama-server lives
#   template=$HOME/models/x/tpl.jinja          (llama, optional) --chat-template-file
#   mmproj=$HOME/models/x/mmproj.gguf          (llama, optional) --mmproj; also turns on image input in the profile
#   args="-ngl 99 --parallel 1 --jinja --temp 0.7 --top-p 0.95"   (llama) flags, before the port ones
#   flags=""                                    (llama) flags, appended last
#   mtp=0                                # llama: --spec-type draft-mtp when 1; strata: --mtp on|off
#   think=auto                           # llama: on|off|auto -> --reasoning.  off is for a model trained
#                                        #   thinking-off: the template's own default is thinking on (xhigh)
#   thinking=                            # the level omp asks this model for, written into models.yml: max (the
#                                        #   default here), or a level the recipe's engine supports.  Clamped by omp
#                                        #   to the model's own list, so a recipe that runs with --reasoning off simply
#                                        #   has no thinking to select.  unset takes the launcher's DEFAULT_THINKING
#   vision=gpu                           (strata) gpu | cpu | off
#   reserve=2048                         (strata) MiB of VRAM kept for the desktop
#   experts=auto                         (strata) auto | mmap | resident: how the experts the GPU does not hold are
#                                        kept.  mmap reads them through the OS page cache; resident copies them into
#                                        RAM once.  Strata's own auto picks resident whenever the pack's arena fits
#                                        RAM minus 10 GB, which on 30 GiB is the wrong answer (the engine then warns
#                                        and falls back to the file cache anyway).  Written into the run config as
#                                        --mmap-experts/--resident-experts, replacing whichever is there.
#   strata_config=strata-q2_0.json       (strata) the run config Strata keeps for this model, in install/
#   judge_url=http://127.0.0.1:8078      a qev/System One decision server for this recipe: its model becomes the
#                                        judge role and auto-thinking, so the effort is a calibrated classification
#                                        instead of a chat model that has to emit a label
#   judge_model=joey-1                   the model id that server reports (its --name)
#   profiles="offline localwork"         omp profiles to rewrite on start (default: offline)
#   hf=ORG/REPO                          where the files come from (Hugging Face), optional
#   files="Q2_0/shard-00001-of-00002.gguf Q2_0/shard-00002-of-00002.gguf"   paths inside the repo
#   bytes="38021379872 28800138432"      expected sizes, checked after the download
#   fetch_dir=$HOME/models/x             where files/ land (default: model's folder, or its dirname)
#
# Flags that override the recipe: --ctx N|128k, --port N, --kv FMT, --model PATH, --print, --yes.
set -e

STRATA=${STRATA:-strata}
RECIPES=${LLM_RECIPES:-$HOME/.local/share/llm/recipes}
OMP_PROFILES_DIR=${OMP_PROFILES_DIR:-$HOME/.omp/profiles}
JUDGE_PID_FILE=${JUDGE_PID_FILE:-$HOME/.local/state/llm-judge.pid}
PORT=${PORT:-8080}
# The effort omp asks for unless a recipe says otherwise.  max is the right default for models served on this
# machine: the cost of more thinking is time, and a recipe that must not think (trained that way) starts its engine
# with thinking off, which leaves omp nothing to select.  A recipe overrides it with thinking=.
DEFAULT_THINKING=${DEFAULT_THINKING:-max}
CTX=${CTX:-}
KV=${KV:-}
MODEL=${MODEL:-}
ASSUME=0
PRINT=0

names() { for f in "$RECIPES"/*.conf; do [ -e "$f" ] || continue; printf '%s\n' "$(basename "$f" .conf)"; done; }
name_list() { names | tr '\n' ' '; }
num() { case "$1" in *k|*K) echo $(( ${1%[kK]} * 1024 ));; *) echo "$1";; esac; }
port_busy() { command -v ss >/dev/null 2>&1 && ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }
human() { numfmt --to=iec "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

# Starting a second model while one is already mapped is how the GPU runs out: two 15 GiB allocations on a 16 GB card
# gave "radv/amdgpu: Not enough memory for command submission" and took the desktop down (2026-11-21).  Every start
# path goes through here, so the check cannot be forgotten at a call site.  A busy *port* is already refused below;
# this covers the model that is resident without holding the port (a stray server, a benchmark, a crashed parent).
# Match every local-inference binary, not just the server: a benchmark (llama-perplexity, llama-bench, llama-cli) or a
# stratum daemon holds the same VRAM and must count.  A pattern of 'llama-server' alone missed a running perplexity and
# let a second model start on top of it (2026-11-21, second crash).
MODEL_PROCS='llama-server|llama-perplexity|llama-bench|llama-cli|llama-quantize|strata serve'
other_model() {
  pgrep -f "$MODEL_PROCS" 2>/dev/null | wc -l
}

usage() {
  cat <<'EOF'
llm — run a locally hosted model in the foreground (Ctrl+C stops it).

  llm                  what is declared, its huggingface source or checkpoint, on disk and running
  llm <name>           run one (Tab completes the names); downloads it first if it is missing and the
                       recipe knows where it lives
  llm <name> --print   show the command, run nothing
  llm fetch <name>     download only (resumable)
  llm prune <name>     delete this recipe's model files (prints the total; --yes to really delete)
  llm new <name>       scaffold a recipe
  llm stop             stop whatever is serving the port
  llm help             this text

flags
  --ctx N|128k   --port N   --kv FMT   --model PATH   --print   --yes

starting a model also rewrites ~/.omp/profiles/offline, so `omp --profile offline` always talks to the model
that llm started last: the model's id becomes the recipe name, every modelRole points at it, and the thinking
level is the recipe's thinking= (default max).
EOF
}

load() {
  about=""; engine=""; model=""; ctx=""; kv=""; llama_dir=""; template=""; mmproj=""; args=""; flags=""
  mtp=0; think=""; thinking=""; judge_url=""; judge_model=""; profiles=""; vision=""; reserve=""; experts=""; strata_config=""; hf=""; files=""; bytes=""; fetch_dir=""
  . "$RECIPES/$1.conf"
  [ -n "$MODEL" ] && model=$MODEL
  CTX=${CTX:-$ctx}
  KV=${KV:-$kv}
  [ "$engine" = "qev" ] || : "${CTX:?llm: $1.conf has no ctx}"
  : "${engine:?llm: $1.conf has no engine}"
  case "$engine" in
    strata) fetch_dir=${fetch_dir:-$model} ;;
    llama)  fetch_dir=${fetch_dir:-$(dirname "$model")} ;;
  esac
}

# is the recipe's model on disk?  (llama: the .gguf; strata: the shard folder with a first shard in it)
complete() {
  # the recipe's bytes="..." against what is on disk: a half-downloaded file is not a model, and curl writes straight
  # to the destination, so a stopped fetch leaves a shorter file that would otherwise read as present
  [ -n "$bytes" ] || return 0
  d=${fetch_dir:-}
  [ -n "$d" ] || case "$engine" in              # the same default load() applies
    strata) d=$model ;;
    *)      d=$(dirname "$model") ;;
  esac
  i=1
  for f in $files; do
    want=$(printf '%s\n' $bytes | sed -n "${i}p")
    [ -n "$want" ] || return 0
    p=$d/$(basename "$f")
    [ -f "$p" ] && [ "$(stat -c %s "$p")" = "$want" ] || return 1
    i=$((i+1))
  done
  return 0
}

present() {
  case "$engine" in
    qev)    [ -f "$model/model.safetensors" ] ;;
    llama)  [ -f "$model" ] && { [ -z "$mmproj" ] || [ -f "$mmproj" ]; } && complete ;;
    # strata: the shard set (-0000N-of-0000M), or the single .gguf a one-file model ships (Gyro: weights and the
    # n-gram table in one file, no shard suffix).  Same test as strata's own find_single().
    strata)
      [ -d "$model" ] || return 1
      if ls "$model"/*-00001-of-*.gguf >/dev/null 2>&1; then complete; return; fi
      set -- "$model"/*.gguf
      [ "$#" = "1" ] && [ -f "$1" ] && case "${1##*/}" in mmproj*) return 1 ;; esac
      complete ;;
  esac
}

state() {
  if present; then echo ok
  elif [ -n "$hf" ]; then echo "missing (llm fetch $1)"
  else echo "MISSING (no hf= in the recipe)"; fi
}

fetch_it() {
  [ -n "$hf" ] || { echo "llm: $1 has no hf=, so it cannot download it; put the files in $model" >&2; return 1; }
  mkdir -p "$fetch_dir"
  i=1
  for f in $files; do
    out=$fetch_dir/$(basename "$f")
    want=$(printf '%s\n' $bytes | sed -n "${i}p")
    if [ -f "$out" ] && { [ -z "$want" ] || [ "$(stat -c %s "$out")" = "$want" ]; }; then
      i=$((i+1)); continue
    fi
    echo "llm: $1 — $f"
    curl -fL -C - --retry 5 --retry-delay 5 -o "$out" "https://huggingface.co/$hf/resolve/main/$f" || return 1
    if [ -n "$want" ] && [ "$(stat -c %s "$out")" != "$want" ]; then
      echo "llm: $out is $(stat -c %s "$out") bytes, expected $want" >&2; return 1
    fi
    i=$((i+1))
  done
}

prune_it() {
  total=0; list=""
  if [ -n "$files" ]; then
    for f in $files; do
      p=$fetch_dir/$(basename "$f")
      [ -f "$p" ] || continue
      total=$((total + $(stat -c %s "$p"))); list="$list $p"
    done
  elif [ -e "$model" ]; then
    total=$(du -sb "$model" 2>/dev/null | cut -f1); list=$model
  fi
  if [ -z "$list" ]; then echo "llm: $1 — nothing on disk"; return 0; fi
  echo "llm: $1 — $(human "$total") in:$list"
  if [ "$ASSUME" != "1" ]; then echo "      nothing deleted; add --yes"; return 0; fi
  # shellcheck disable=SC2086
  rm -rf $list
  echo "      deleted"
}

# The shared omp profiles, one per `profiles=` entry: provider "local" with the recipe name as id, context and image
# support from the recipe, plus the decision-model provider when the recipe names one.
write_profile() {
  # profiles="offline localwork" writes every profile; the default is just the one.
  for prof in ${profiles:-offline}; do
    write_one_profile "$prof" "$1"
  done
}

write_one_profile() {
  prof=$1; name=$2
  dir=$OMP_PROFILES_DIR/$prof/agent
  mkdir -p "$dir"
  case "$engine" in
    strata) in_img=", image"; [ "${vision:-on}" = "off" ] && in_img="" ;;
    *)      in_img=""; [ -n "${mmproj:-}" ] && in_img=", image" ;;
  esac
  maxtok=32768
  [ "$CTX" -lt "$maxtok" ] && maxtok=$(( CTX / 2 ))
  # The model id is the recipe name, not the constant "local": omp labels a model by its id in `omp models` and in the
  # picker's search, so a constant id made every model read as "local".  The id is what `--model` and modelRoles match
  # on, so the roles are rewritten with it in the same breath.
  {
    cat <<EOF
# Written by \`llm $name\` — refreshed on every start, do not edit by hand.
# Talk to it with: omp --profile $prof
providers:
  local:
    baseUrl: http://127.0.0.1:$PORT/v1
    api: openai-completions
    authHeader: true
    apiKey: none
    auth: apiKey
    models:
      - id: $name
        name: $about
        reasoning: true
        input: [text$in_img]
        cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0}
        contextWindow: $CTX
        maxTokens: $maxtok
EOF
    if [ -n "$judge_url" ]; then
      cat <<EOF
      - id: ${judge_model:-joey-1}
        name: ${judge_model:-joey-1} — decision model for auto-thinking
        api: typesafe
        baseUrl: $judge_url
        kind: judge
        authHeader: false
        apiKey: none
        cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0}
        contextWindow: 32768
        maxTokens: 16384
EOF
    fi
    # A decision server is a different api kind: typed answers, calibrated probabilities, no label parsing and no
    # thinking budget to collide with.  It becomes the judge role and the auto-thinking backend below.
    if [ -n "$judge_url" ]; then
      # The decision model is declared TWICE, on purpose.  `providers.autoThinkingModel: <name>` resolves to
      # `local/<name>` — omp never looks under another provider for it (measured: with the model only under `judge`,
      # auto-thinking made no request to it at all and fell back to a level).  So it is a model of `local` with its own
      # baseUrl (per-model baseUrl is supported), which is what makes `local/<name>` and the judge role agree.
      cat <<EOF
  judge:
    baseUrl: $judge_url
    api: typesafe
    authHeader: false
    apiKey: none
    auth: apiKey
    models:
      - id: ${judge_model:-joey-1}
        name: ${judge_model:-joey-1} — System One decision model (CPU, out of process)
        kind: judge
        cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0}
        contextWindow: 32768
        maxTokens: 16384
EOF
    fi
  } > "$dir/models.yml"
  write_roles "$dir" "$name" "${thinking:-$DEFAULT_THINKING}" "$([ -n "$judge_url" ] && echo "${judge_model:-joey-1}")"
  echo "llm: omp profile '$prof' now points at $name (port $PORT, $CTX ctx, thinking ${thinking:-$DEFAULT_THINKING}$([ -n "$judge_url" ] && echo ", judge ${judge_model:-joey-1}"))"
}

# Every role config.yml declares points at this one model, so the roles belong to whoever writes models.yml.  Only the
# role lines are touched (and enabledModels): the rest of the file is the user's — feature switches, thinking level,
# disabled providers — and rewriting it whole would silently undo their edits.
write_roles() {
  cfg=$1/config.yml
  [ -f "$cfg" ] || return 0
  awk -v id="$2" -v level="$3" -v jid="$4" '
    /^modelRoles:/ { print; inroles=1; next }
    inroles && /^[^[:space:]#]/ { inroles=0 }
    # The judge is its own provider, not `local/*`: `local/*` would resolve the judge role to the chat model.  This
    # line must be PRINTED — a bare `next` drops it from the live file awk writes, which silently removed the role and
    # sent auto-thinking back to the chat model.  With a recipe judge it is pinned; without one it is left as written.
    inroles && /^[[:space:]]*judge:/ { print; next }   # tracked source owns this line; print it unchanged
    inroles && /^[[:space:]]+[a-zA-Z]+:/ { sub(/:.*/, ": local/" id); print; next }
    /^enabledModels:/ { print; inen=1; next }
    inen && /^[[:space:]]*-/ { if (!done) { print "  - local/" id; done=1; if (jid != "") print "  - judge/" jid }; next }
    inen && /^[^[:space:]#]/ { inen=0 }
    /^defaultThinkingLevel:/ { print "defaultThinkingLevel: " level; seen=1; next }
    { print }
    END { if (!seen) print "defaultThinkingLevel: " level }
  ' "$cfg" > "$cfg.llm-tmp" && mv "$cfg.llm-tmp" "$cfg"
}

# The judge a recipe names (judge_url) is a separate process on a separate port, and it used to be started by hand:
# `llm pi27` would come up with the judge role pointing at a port nobody was serving.  These two make it part of the
# model's lifecycle — started just before the model execs, stopped with it — and idempotent, so a judge already
# serving is reused rather than duplicated (two copies on one port is how the VRAM guard was added).
judge_port() { printf '%s\n' "$judge_url" | sed -E 's#.*:([0-9]+)/?$#\1#'; }
judge_up() {
  [ -n "$judge_url" ] || return 0
  jp=$(judge_port)
  if port_busy "$jp"; then
    echo "llm: judge already serving on $jp"
    return 0
  fi
  # the recipe that owns this URL (joey1.conf) says how to run it
  jr=""
  for f in "$RECIPES"/*.conf; do
    ( unset judge_url; . "$f" 2>/dev/null; [ "${port:-}" = "$jp" ] && [ "${engine:-}" = "qev" ] ) && jr=$(basename "$f" .conf)
  done
  [ -n "$jr" ] || { echo "llm: $judge_url is down and no qev recipe owns port $jp" >&2; return 1; }
  echo "llm: starting judge $jr on $jp (background; llm stop ends it)"
  ( . "$RECIPES/$jr.conf"
    nohup "$qev_python" -m qev.cli serve --model "$model" --name "${qev_name:-$jr}" \
      --device "${device:-cpu}" --dtype "${dtype:-float32}" --host 127.0.0.1 --port "$jp" \
      >>"${TMPDIR:-/tmp}/llm-judge-$jr.log" 2>&1 & echo $! > "$JUDGE_PID_FILE" )
  i=0
  while [ $i -lt 90 ]; do
    curl -sf "http://127.0.0.1:$jp/health" >/dev/null 2>&1 && { echo "llm: judge $jr ready"; return 0; }
    sleep 1; i=$((i+1))
  done
  echo "llm: judge $jr did not answer on $jp after 90s (log: ${TMPDIR:-/tmp}/llm-judge-$jr.log)" >&2
  return 1
}
judge_down() {
  [ -f "$JUDGE_PID_FILE" ] || return 0
  pid=$(cat "$JUDGE_PID_FILE" 2>/dev/null)
  [ -n "$pid" ] && kill "$pid" 2>/dev/null && echo "llm: judge stopped (pid $pid)"
  rm -f "$JUDGE_PID_FILE"
}

stop_all() {
  "$STRATA" launch --stop >/dev/null 2>&1 || true
  pkill -x llama-server 2>/dev/null || true
  judge_down
  sleep 1
  port_busy "$PORT" && { echo "llm: still something on $PORT (ss -ltnp 'sport = :$PORT')" >&2; exit 1; }
  echo "llm: stopped"
}

scaffold() {
  n=${1:-}
  case "$n" in ""|*/*|.*) echo "llm new <name>: a plain name, e.g. 'llm new qwen27'" >&2; exit 2 ;; esac
  f=$RECIPES/$n.conf
  [ -e "$f" ] && { echo "llm: $f exists" >&2; exit 1; }
  mkdir -p "$RECIPES"
  cat > "$f" <<EOF
about="what it is, in one line"
engine=llama
model=\$HOME/models/$n/model.gguf
ctx=32768
kv=q4_0
llama_dir=\$HOME/.local/opt/llama-b12079
template=""
args="-ngl 99 --parallel 1 --jinja --temp 0.7 --top-p 0.95"
flags=""
# think=auto   # on|off|auto -> --reasoning (off for a model trained thinking-off)
# optional, for \`llm fetch\`:
# hf=ORG/REPO
# files="NAME.gguf"
# bytes="123"
EOF
  echo "llm: wrote $f — fill in model/ctx/kv/args, then: llm list && llm $n --print"
}

cmd=${1:-}
[ $# -gt 0 ] && shift || true

case "$cmd" in
  ""|list|ls)
    printf '\n%-10s %-7s %-7s %-6s %s\n' NAME ENGINE CTX KV STATE
    for n in $(names); do
      ( about=""; engine="?"; model=""; ctx=""; kv=""; hf=""; files=""
        . "$RECIPES/$n.conf"
        case "$engine" in
          llama|strata|qev) s=$(present && echo ok || { [ -n "$hf" ] && echo "missing (llm fetch $n)" || echo "MISSING (no hf=)"; }) ;;
          *)      s="no engine" ;;
        esac
        printf '%-10s %-7s %-7s %-6s %s\n' "$n" "$engine" "$ctx" "$kv" "$s — $about"
        # where the weights come from: the HF repo (naming the file when the recipe is one file) or the checkpoint
        if [ -z "$hf" ]; then
          printf '%-10s %s (no hf= in the recipe)\n' "" "$model"
        else
          src="https://huggingface.co/$hf"
          set -- $files
          if [ "$engine" = "llama" ] && [ $# -eq 1 ]; then src="$src/$1"
          elif [ $# -gt 0 ]; then src="$src ($# files)"; fi
          printf '%-10s %s\n' "" "$src"
        fi )
    done
    echo
    if port_busy "$PORT"; then echo "serving on 127.0.0.1:$PORT — llm stop to end it"; else echo "nothing is serving on $PORT"; fi
    exit 0 ;;
  help|-h|--help) usage; exit 0 ;;
  stop) stop_all; exit 0 ;;
  new) scaffold "$1"; exit 0 ;;
  fetch|prune)
    action=$cmd; n=${1:-}; shift || true
    case " $(name_list) " in *" $n "*) ;; *) echo "llm: no recipe '$n'. Declared: $(name_list)" >&2; exit 2 ;; esac
    case "$1" in --yes) ASSUME=1 ;; esac
    load "$n"
    if [ "$action" = "fetch" ]; then fetch_it "$n"; echo "llm: $n — $(state "$n")"; else prune_it "$n"; fi
    exit 0 ;;
esac

case " $(name_list) " in
  *" $cmd "*) ;;
  *) echo "llm: no recipe '$cmd'. Declared: $(name_list)(llm new $cmd to add one)" >&2; exit 2 ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --ctx)      CTX=$(num "$2"); shift 2 ;;
    --ctx=*)    CTX=$(num "${1#*=}"); shift ;;
    --port)     PORT=$2; shift 2 ;;
    --port=*)   PORT=${1#*=}; shift ;;
    --kv)       KV=$2; shift 2 ;;
    --kv=*)     KV=${1#*=}; shift ;;
    --model)    MODEL=$2; shift 2 ;;
    --model=*)  MODEL=${1#*=}; shift ;;
    --print|-n) PRINT=1; shift ;;
    --yes|-y)   ASSUME=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "llm: unknown option '$1' (llm help)" >&2; exit 2 ;;
  esac
done

load "$cmd"

if [ "$PRINT" = "0" ] && port_busy "$PORT"; then
  echo "llm: $PORT is in use — llm stop first (or --port 8081)" >&2; exit 1
fi

# Second guard: a model already resident on another port (or a stray benchmark) still owns the VRAM, and starting a
# second one is what crashed the machine on 2026-11-21.  --print stays silent so it can still show the command.
if [ "$PRINT" = "0" ]; then
  n=$(other_model)
  if [ "$n" != "0" ]; then
    echo "llm: $n model process(es) already running — llm stop first" >&2
    pgrep -af "$MODEL_PROCS" | sed 's/^/     /' >&2
    exit 1
  fi
fi

if ! present; then
  if [ "$PRINT" = "1" ]; then
    echo "llm: $cmd — model is not on disk; a start would run: llm fetch $cmd"
  else
    fetch_it "$cmd"
    present && : || { echo "llm: $cmd still missing after the download" >&2; exit 1; }
  fi
fi

case "$engine" in
  llama)
    : "${llama_dir:?llm: $cmd.conf has no llama_dir}"
    server=$llama_dir/llama-server
    [ -x "$server" ] || { echo "llm: $server is missing" >&2; exit 1; }
    set -- "$server" -m "$model" -c "$CTX" -ctk "$KV" -ctv "$KV"
    [ -n "$args" ] && set -- "$@" $args
    if [ -n "$template" ]; then
      [ -f "$template" ] || { echo "llm: template not found: $template" >&2; exit 1; }
      set -- "$@" --chat-template-file "$template"
    fi
    [ -n "$mmproj" ] && set -- "$@" --mmproj "$mmproj"
    [ "${mtp:-0}" = "1" ] && set -- "$@" --spec-type draft-mtp
    # think=off for a model trained thinking-off.  --reasoning off is what reaches the template: measured on
    # b12608 and b12079, the server turns it into enable_thinking=false and the prompt ends with an empty
    # <think></think> block, whereas the template's own default (enable_thinking undefined) opens a thinking block
    # and, for the qwen35 family, also injects the "reasoning effort is set to xhigh" instruction.  Passing
    # --chat-template-kwargs '{"enable_thinking": false}' as well is redundant and deprecated on b12608.
    case "${think:-auto}" in
      off)  set -- "$@" --reasoning off ;;
      on)   set -- "$@" --reasoning on ;;
      auto) set -- "$@" --reasoning auto ;;
      *)    echo "llm: $cmd.conf has think='$think'; use on, off or auto" >&2; exit 2 ;;
    esac
    [ -n "$flags" ] && set -- "$@" $flags
    set -- "$@" --host 127.0.0.1 --port "$PORT"
    if [ "$PRINT" = "1" ]; then
      echo "llm: $cmd | port $PORT — this is what would run:"
      printf '  '; printf '%s ' "$@" | sed "s|$HOME|~|g"; echo; exit 0
    fi
    write_profile "$cmd"
    judge_up || { echo "llm: refusing to start without the judge the profile names (llm stop clears a stale one)" >&2; exit 1; }
    echo "llm: $cmd | port $PORT | ctx $CTX | kv $KV — Ctrl+C stops it"
    exec "$@"
    ;;
  strata)
    vision=${vision:-on}; reserve=${reserve:-2048}; mtp=${mtp:-0}; experts=${experts:-auto}
    strata_config=${strata_config:-strata-$cmd.json}
    CFG=$HOME/.local/share/strata/install/$strata_config
    setup=0
    if [ ! -f "$CFG" ]; then
      setup=1
    else
      python3 - "$CFG" "$CTX" "$KV" "$vision" <<'PY' || setup=1
import json, sys
cfg, ctx, kv, vision = sys.argv[1:5]
c = json.load(open(cfg))
args = [str(a) for a in (c.get("args") or [])]
def val(flag):
    return args[args.index(flag) + 1] if flag in args and args.index(flag) + 1 < len(args) else None
ok = (val("--max-context") == ctx and val("--kv") == kv
      and bool((c.get("vision") or {}).get("gpu")) == (vision == "gpu"))
sys.exit(0 if ok else 1)
PY
    fi
    if [ "$PRINT" = "1" ]; then
      echo "llm: $cmd | strata | ctx $CTX | kv $KV | vision $vision | reserve ${reserve} MiB | experts $experts | config $strata_config"
      [ "$setup" = "1" ] && echo "    would first: $STRATA launch --model-path $model --context $CTX --kv $KV --vision $vision --parallel 1 --set vram-reserve-mib=$reserve --set STRATA_PREFILL_CPU_SHARE=auto --mtp $([ "$mtp" = 1 ] && echo on || echo off) --no-tui --yes (then --stop)"
      echo "    then: $STRATA serve --profile $CFG --host 127.0.0.1 --port $PORT"
      exit 0
    fi
    if [ "$setup" = "1" ]; then
      echo "llm: preparing $cmd for ctx $CTX / kv $KV / reserve $reserve MiB / vision $vision (a pack is built once)"
      set -- --model-path "$model" --context "$CTX" --kv "$KV" --vision "$vision" --parallel 1 \
             --port "$PORT" --set "vram-reserve-mib=$reserve" --set STRATA_PREFILL_CPU_SHARE=auto --no-tui --yes
      [ "$mtp" = "1" ] && set -- "$@" --mtp on || set -- "$@" --mtp off
      "$STRATA" launch "$@" >/dev/null
      "$STRATA" launch --stop >/dev/null 2>&1 || true
      sleep 1
    fi
    # Setup owns the reserve and the expert mode, and gets both wrong here: it writes 700 MiB of VRAM reserve for a
    # 16 GB card (the desktop then has 608 MiB), and --resident-experts whenever the pack's arena fits RAM minus 10 GB
    # — which on 30 GiB it does, though the engine then finds the resident complement does not fit beside the desktop
    # and falls back to the file cache mid-prompt anyway.  The run config is a plain file, so write the recipe's
    # answers over it.  Both go into user_args too: every serve, setup run and app start merges those over args, so a
    # later setup cannot undo them.  The mode is renamed in place rather than added, because a config holding both
    # --resident-experts and --mmap-experts runs the resident one.
    python3 - "$CFG" "$reserve" "$experts" <<'PYCONF'
import json, sys
path, reserve, experts = sys.argv[1:4]
def _groups(argv):
    """An argument list as groups: a flag and the values after it (--flag VALUE), so a group can be replaced whole."""
    out = []
    for a in argv or []:
        if str(a).startswith("--") or not out:
            out.append([str(a)])
        else:
            out[-1].append(str(a))
    return out
cfg = json.load(open(path))
args = [str(a) for a in (cfg.get("args") or [])]
if "--vram-reserve-mib" in args:
    args[args.index("--vram-reserve-mib") + 1] = reserve
else:
    args += ["--vram-reserve-mib", reserve]
mine = [g for g in _groups(cfg.get("user_args")) if g[0] != "--vram-reserve-mib"]
if experts != "auto":
    want, other = "--" + experts + "-experts", "--" + ("resident" if experts == "mmap" else "mmap") + "-experts"
    args = [want if a == other else a for a in args]
    if want not in args:
        args.append(want)
    mine = [g for g in mine if g[0] not in (want, other)] + [[want]]
cfg["args"] = args
cfg["user_args"] = [t for g in mine for t in g] + ["--vram-reserve-mib", reserve]
cfg["args_written"] = list(args)
json.dump(cfg, open(path, "w"), indent=1)
PYCONF
    write_profile "$cmd"
    echo "llm: $cmd | ctx $CTX | kv $KV | vision $vision | reserve $reserve MiB | experts $experts | port $PORT — Ctrl+C stops it"
    exec "$STRATA" serve --profile "$CFG" --host 127.0.0.1 --port "$PORT"
    ;;
  qev)
    : "${qev_python:?llm: $cmd.conf has no qev_python}"
    [ -x "$qev_python" ] || { echo "llm: $qev_python is missing" >&2; exit 1; }
    QPORT=${port:-8078}
    set -- -m qev.cli serve --model "$model" --name "${qev_name:-$cmd}" --device "${device:-cpu}" \
           --dtype "${dtype:-float32}" --host 127.0.0.1 --port "$QPORT"
    if [ "$PRINT" = "1" ]; then
      echo "llm: $cmd | qev | port $QPORT | device ${device:-cpu} ${dtype:-float32} — this is what would run:"
      printf '  '; printf '%s ' "$qev_python" "$@" | sed "s|$HOME|~|g"; echo; exit 0
    fi
    echo "llm: $cmd | qev | port $QPORT | device ${device:-cpu} — Ctrl+C stops it"
    exec "$qev_python" "$@"
    ;;
  *)
    echo "llm: $cmd.conf has engine='$engine'; use llama, strata or qev" >&2; exit 2 ;;
esac
