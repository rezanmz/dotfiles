#!/usr/bin/env python3
"""llm-monitor — nvtop-style live line graphs for a running llama.cpp server.

Each panel is a bordered box: a braille line chart (2x4 dots per character cell, so a smooth line rather than a
filled bar), a labelled y axis and a time x axis.  Panels: generation tok/s, prefill tok/s, and prompt-cache tokens.

Counter notes, both learned by measuring:
  * n_prompt_tokens           the CONTEXT size; it keeps growing during generation (one per token)
  * n_prompt_tokens_processed how much of the prompt has been evaluated — the real prefill counter
  * n_prompt_tokens_cache     prompt tokens served from the server's cache for the current request
All three are per-request and snap to 0 when it finishes, so a decrease is a request boundary, not negative
throughput: the finished work is banked into the session totals and that tick reads 0.

Strata models are not handled here; `llm monitor` delegates those to `strata monitor`.

    llm-monitor --port 8080 [--name pi27] [--interval 1] [--once]
"""

import argparse
import json
import shutil
import signal
import sys
import time
import urllib.request

R = "\033[0m"
D = "\033[2m"
B = "\033[1m"
GREEN = "\033[32m"
CYAN = "\033[36m"
MAGENTA = "\033[35m"
RED = "\033[31m"
HOME = "\033[H"
CLEAR_BELOW = "\033[J"

# Braille dots, indexed [row_in_cell (0 = top)][dot_column (0 = left)].
BITS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


def blank(n):
    return "\u2800" * n  # braille blank: keeps every line exactly n cells wide


def line(vals, width, height):
    """A 1-pixel-wide connected line: 2 horizontal dot-columns per character cell, so each sample is one dot and
    the run between two samples is one pixel wide.  Filling both dot columns of a cell (the obvious first
    implementation) draws a 2-pixel bar per sample, which reads as a bar chart, not a line."""
    if width <= 0 or height <= 0:
        return []
    px_w = width * 2  # dot columns available
    v = list(vals)[-px_w:]
    v = [0.0] * (px_w - len(v)) + v
    hi = max(v) or 1.0
    px_h = height * 4  # dot rows available
    ys = [min(px_h - 1, max(0, int(round((x / hi) * (px_h - 1))))) for x in v]

    cells = [[0] * width for _ in range(height)]
    for i, y in enumerate(ys):
        prev = ys[i - 1] if i else y
        cx, dcol = divmod(i, 2)          # one sample -> one dot column
        for p in range(min(prev, y), max(prev, y) + 1):
            row = height - 1 - (p // 4)
            cells[row][cx] |= BITS[p % 4][dcol]
    return ["".join(chr(0x2800 + c) if c else "\u2800" for c in row) for row in cells]


def hnum(x):
    if x >= 1_000_000:
        return f"{x/1_000_000:.1f}M"
    if x >= 10_000:
        return f"{x/1_000:.0f}k"
    if x >= 1_000:
        return f"{x/1_000:.1f}k"
    if x >= 10:
        return f"{x:.0f}"
    return f"{x:.1f}"


def panel(title, readout, body, width, colour="", ymax=None, span=None):
    """A bordered box with a y axis down the left of the plot and a time axis under it."""
    inner = max(1, width - 2)
    left = f" {title} "
    tab = f" {readout} " if readout else ""
    fill = inner - len(left) - len(tab)
    if fill < 0:
        tab, fill = "", max(0, inner - len(left))
    out = ["┌" + colour + B + left + R + "─" * fill + D + tab + R + "┐"]

    gut = 5  # "  1.2k " -> the y label column
    plot_w = max(4, inner - 2 - gut)
    rows = line(body, plot_w, HEIGHT_ROWS)
    for i, row in enumerate(rows):
        if ymax is None:
            lab = ""
        elif i == 0:
            lab = hnum(ymax)
        elif i == len(rows) - 1:
            lab = "0"
        elif i == len(rows) // 2:
            lab = hnum(ymax / 2)
        else:
            lab = ""
        out.append("│ " + f"{D}{lab:>4}{R} " + colour + row + R + " │")

    # x axis: drawn as a rule of exact width with the labels overwritten onto it, so it can never overflow.
    if span:
        content = inner - 2                      # the text between "│ " and " │"
        buf = ["─"] * content
        for i in range(max(0, gut - 1)):   # the y-label gutter: no rule there, the └ marks where the plot starts
            buf[i] = " "
        def put(text, pos):
            for i, ch in enumerate(text):
                if 0 <= pos + i < content:
                    buf[pos + i] = ch
        put("└", gut - 1)
        put(f"-{span}s", gut)
        mid = f"-{span // 2}s"
        plot_start, plot_end = gut + 2, content - 1
        put(mid, plot_start + (plot_end - plot_start - len(mid)) // 2)
        put("now", content - 3)
        out.append("│ " + D + "".join(buf) + R + " │")
    out.append("└" + "─" * inner + "┘")
    return out


HEIGHT_ROWS = 5


def build(port, name, series, stats, width, span, err=None):
    w = max(46, min(width, 140))
    out = []
    head = f" {B}{name or 'model'}{R}  {D}127.0.0.1:{port}{R}"
    if err:
        head += f"   {RED}{err}{R}"
    out.append(head)
    out.append("")

    for title, s, colour, unit in (
        ("generation", series["gen"], GREEN, "tok/s"),
        ("prefill", series["pre"], CYAN, "tok/s"),
        ("prompt cache", series["cache"], MAGENTA, "tokens"),
    ):
        readout = f"now {hnum(s.now())}  avg {hnum(s.avg())}  peak {hnum(s.peak())} {unit}"
        out.extend(panel(title, readout, s.v, w, colour, ymax=max(s.peak(), 1.0), span=span))

    out.append("")
    out.append(
        f" {D}generated{R} {B}{hnum(stats['gen_total'])}{R}   "
        f"{D}prefilled{R} {B}{hnum(stats['pre_total'])}{R}   "
        f"{D}cached{R} {B}{hnum(stats['cache_now'])}{R}   "
        f"{D}requests{R} {B}{stats['requests']}{R}   "
        f"{'busy' if stats['busy'] else 'idle'}   {D}uptime {stats['uptime']}{R}   "
        f"{D}ctrl-c to leave{R}"
    )
    return out


class Series:
    def __init__(self, window):
        self.window = window
        self.v = []

    def add(self, x):
        self.v.append(float(x))
        if len(self.v) > self.window:
            self.v = self.v[-self.window:]

    def now(self):
        return self.v[-1] if self.v else 0.0

    def avg(self):
        nz = [x for x in self.v if x > 0]  # active samples only: idle ticks would drag the average to 0
        return (sum(nz) / len(nz)) if nz else 0.0

    def peak(self):
        return max(self.v) if self.v else 0.0


def get(url, timeout=3.0):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8080)
    ap.add_argument("--name", default="")
    ap.add_argument("--interval", type=float, default=1.0)
    ap.add_argument("--window", type=int, default=None, help="samples kept (default: one per plot column)")
    ap.add_argument("--once", action="store_true", help="print one reading and exit (for scripts)")
    a = ap.parse_args()

    base = f"http://127.0.0.1:{a.port}"
    cols = max(46, min(shutil.get_terminal_size((100, 24)).columns, 140)) - 2 - 2 - 5
    window = a.window or max(40, cols * 2)   # two samples per character cell
    series = {k: Series(window) for k in ("gen", "pre", "cache")}

    prev = None
    gen_total = pre_total = 0
    requests = 0
    t0 = time.time()
    first = True

    def bye(*_):
        sys.stdout.write(R + "\n")
        sys.stdout.flush()
        raise SystemExit(0)

    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGTERM, bye)

    while True:
        err = None
        try:
            slots = get(base + "/slots")
        except Exception:
            slots, err = [], "not answering"

        proc_now = sum(s.get("n_prompt_tokens_processed") or 0 for s in slots)
        dec_now = sum((s.get("next_token") or [{}])[0].get("n_decoded") or 0 for s in slots)
        cache_now = sum(s.get("n_prompt_tokens_cache") or 0 for s in slots)
        busy = any(s.get("is_processing") for s in slots)

        if prev is None:
            d_p = d_g = 0.0
        else:
            pp, gg = prev
            if proc_now >= pp:
                d_p = (proc_now - pp) / a.interval
            else:
                pre_total += pp
                d_p = 0.0
            if dec_now >= gg:
                d_g = (dec_now - gg) / a.interval
            else:
                gen_total += gg
                requests += 1
                d_g = 0.0

        series["gen"].add(d_g)
        series["pre"].add(d_p)
        series["cache"].add(cache_now)
        prev = (proc_now, dec_now)

        stats = {
            "gen_total": gen_total + dec_now,
            "pre_total": pre_total,
            "cache_now": cache_now,
            "requests": requests,
            "busy": busy,
            "uptime": time.strftime("%H:%M:%S", time.gmtime(time.time() - t0)),
        }

        lines = build(a.port, a.name, series, stats, shutil.get_terminal_size((100, 24)).columns, window, err)
        if a.once:
            print("\n".join(l.replace(R, "").replace(D, "").replace(B, "") for l in lines))
            return
        sys.stdout.write(("\033[2J" if first else "") + HOME + "\n".join(lines) + "\n" + CLEAR_BELOW)
        sys.stdout.flush()
        first = False
        time.sleep(a.interval)


if __name__ == "__main__":
    main()
