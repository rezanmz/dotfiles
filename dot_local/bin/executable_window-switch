#!/bin/sh
# Window switcher: list Hyprland windows with anyrun and focus the chosen one.
# Bound to SUPER+Tab.
#
# UPDATED for anyrun. The picker is now
#
#   hyprctl clients -j | <format rows> | anyrun --plugins libstdin.so --show-results-immediately true
#
# `--plugins` overrides config.ron so only stdin loads and the list is nothing
# but windows — the anyrun equivalent of `rofi -dmenu`.
#
# Two details worth keeping in sync with the code below:
#
#   Rows are matched as TEXT, then mapped back to a freshly-read client list by
#       looking the row up again. rofi had a `-format i` flag that printed the
#       row index and made this an O(1) lookup; stdin returns the chosen line
#       and nothing else, so the mapping is by row text instead. The count of
#       rows is checked first, and a row that no longer exists is simply not
#       focused — so a window closing while the picker is open can never land
#       the focus on the wrong window.
#
#   The address is never shown: rows read "class  —  title". The 0x address is
#       only ever used internally, exactly as before.
set -eu

# One row per window: class, an em dash, then the title (truncated).
list_windows='
import json, sys
for c in json.load(sys.stdin):
    if not c.get("mapped", True):
        continue
    title = (c.get("title") or "").strip()
    cls = (c.get("class") or "").strip()
    if not title and not cls:
        continue
    print(cls + "  —  " + title[:80])
'

# Map the chosen row back to a window address. Read fresh, so the mapping
# reflects reality at selection time rather than at list time.
resolve_row='
import json, sys
want = sys.argv[1]
for c in json.load(sys.stdin):
    if not c.get("mapped", True):
        continue
    title = (c.get("title") or "").strip()
    cls = (c.get("class") or "").strip()
    if not title and not cls:
        continue
    if cls + "  —  " + title[:80] == want:
        print(c["address"])
        break
'

choice=$(hyprctl clients -j | python3 -c "$list_windows" |
    anyrun --plugins libstdin.so --show-results-immediately true) || exit 0

[ -n "$choice" ] || exit 0

addr=$(hyprctl clients -j | python3 -c "$resolve_row" "$choice")
[ -n "$addr" ] || exit 0

hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
