// Actions plugin — replaces the old rofi-session script.
//
// The built-in power actions are exactly the ones the rofi session menu
// provided (lock, log out, power off, reboot, suspend), so they are left
// enabled rather than redefined. The plugin's own defaults are already the
// right commands:
//
//   Lock      loginctl lock-session          (no confirm)
//   Log out   loginctl terminate-session …   (confirm)
//   Power off systemctl poweroff             (confirm)
//   Reboot    systemctl reboot               (confirm)
//   Suspend   systemctl suspend              (no confirm)
//
// Reboot and Power off carry a confirmation prompt, which is the guard the
// hand-written script had to implement itself. Leaving `confirm` alone is
// therefore deliberate: these are the destructive entries.
//
// Custom actions added below are the two things the old script did that the
// built-ins do not cover, plus a couple of frequently used one-shots.

Config(
    enable_power_actions: true,

    custom_actions: [
        (
            title: "Log out to ly",
            // uwsm stops the graphical session and hands the tty back to ly,
            // which is the display manager this machine uses. This is the same
            // command the rofi session script ran.
            command: "uwsm stop",
            description: "Stop the graphical session, return to ly",
            icon: "system-log-out",
            confirm: true,
        ),
        (
            title: "Reload Hyprland config",
            command: "hyprctl reload",
            description: "Re-read hyprland.lua and the modules",
            icon: "view-refresh",
            confirm: false,
        ),
        (
            title: "Restart waybar",
            command: "systemctl --user restart waybar",
            description: "Pick up changes to the bar configuration",
            icon: "view-refresh",
            confirm: false,
        ),
    ],
)
