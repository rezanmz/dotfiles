// Actions plugin — the power/session menu, replacing the old rofi-session script.
//
// WHY THE BUILT-INS ARE OFF
//
// `enable_power_actions: true` ships Lock / Log out / Power off / Reboot /
// Suspend / Hibernate with hardcoded titles, and the plugin matches on title and
// description ONLY (Action::fuzzy_score — there is no keyword field to configure).
//
// So typing "power" returned just "Power off", because fuzzy matching is
// subsequence-based: the letters p-o-w-e-r appear in that title and in no other
// one. "Reboot", "Suspend" and "Hibernate" are not power-related in any way the
// matcher can see. No config option fixes that against the built-ins.
//
// The workaround is to define the same actions here with a shared
// "Power menu —" description. Now every one of them contains the word "power",
// so a single query surfaces the whole group, and the prefix doubles as a
// readable category hint in the result list. Descriptions are scored at half the
// weight of titles, so "Power off" still ranks first for the query "power" —
// which is the sensible ordering.
//
// Commands are the upstream ones, with one deliberate change: "Log out" uses
// `uwsm stop` rather than `loginctl terminate-session`. This session is
// uwsm-managed and the display manager is ly, so uwsm stop is what hands the tty
// back cleanly; the loginctl form would not run the session teardown hooks.
//
// `confirm: true` on the four destructive entries keeps the guard that upstream
// applies — note the confirmation lists "Proceed" first, so a stray second Enter
// will go through with it.

Config(
    enable_power_actions: false,

    custom_actions: [
        (
            title: "Lock",
            command: "loginctl lock-session",
            description: "Lock the session screen",
            icon: "system-lock-screen",
            confirm: false,
        ),
        (
            title: "Log out",
            command: "uwsm stop",
            description: "Power menu — end the session and return to ly",
            icon: "system-log-out",
            confirm: true,
        ),
        (
            title: "Power off",
            command: "systemctl poweroff || poweroff",
            description: "Power menu — shut the system down",
            icon: "system-shutdown",
            confirm: true,
        ),
        (
            title: "Reboot",
            command: "systemctl reboot || reboot",
            description: "Power menu — restart the system",
            icon: "system-reboot",
            confirm: true,
        ),
        (
            title: "Suspend",
            command: "systemctl suspend || pm-suspend",
            description: "Power menu — suspend to RAM",
            icon: "system-suspend",
            confirm: false,
        ),
        (
            title: "Hibernate",
            command: "systemctl hibernate || pm-hibernate",
            description: "Power menu — suspend to disk",
            icon: "system-suspend-hibernate",
            confirm: false,
        ),
        (
            title: "Reload Hyprland config",
            command: "hyprctl reload",
            description: "Re-read hyprland.lua and its modules",
            icon: "view-refresh",
            confirm: false,
        ),
        (
            title: "Restart waybar",
            command: "systemctl --user restart waybar",
            description: "Pick up changes to the bar configuration",
            icon: "view-refresh",
            confirm: false,
        ),
    ],
)
