// anyrun configuration — replaces rofi (and fuzzel before it).
//
// Managed by chezmoi: source lives in ~/.local/share/chezmoi/dot_config/anyrun.
//
// anyrun reads config.ron and style.css from its config directory, and each
// plugin reads its own <plugin>.ron from the same directory. Plugin paths in
// `plugins` may be bare library names, which are resolved against anyrun's
// plugin directory, or absolute paths.
//
// Plugin order defines result priority: applications first, then the power
// actions, then the calculator. Actions sit above the calculator so that
// typing "lock" or "reboot" reaches them without having to out-rank a
// mathematical reading of the same words.
//
// Position and size are measured from the rofi window this replaces, so the
// switch does not move the runner on screen.
//
// rofi, with no location set, centred its window horizontally *and* vertically.
// Measured on this machine with a live run: x=830 y=845 w=1413 h=82 on a
// 3072x1728 logical screen under a 44px exclusive zone.
//
// anyrun resolves Fraction() against the FULL monitor geometry — app.rs passes
// `monitor.geometry()`, not the usable area — so the fractions below are
// proportions of 3072x1728:
//
//     width: 0.46  -> 1413px                    (rofi: 1413)
//     x:     0.5   -> 1536 - 1413/2 = 830px     (rofi: 830)
//
// Rounding the width to 0.5 would make it 1536px and shift the left edge to
// 768, a visible 62px jump.

Config(
    // Centred horizontally, which is rofi's own default.
    x: Fraction(0.5),

    // Centred vertically. rofi's centre was 845 rather than 864 because it
    // centres inside the usable area and subtracts half its height; anyrun
    // centres on the full geometry and subtracts half of `height` (1px). The
    // ~19px difference is the one detectable change and is cosmetic.
    y: Fraction(0.5),

    // 0.46 of 3072 = 1413px, matching the rofi window exactly.
    width: Fraction(0.46),

    // Minimum height. 1px means "shrink to fit the entries" — with Absolute(0)
    // the window would never shrink again after expanding.
    height: Absolute(1),

    // Keep the Nerd Font plugin icons; they are what makes the rows scannable.
    hide_icons: false,
    hide_plugin_info: false,


    /*
     * Respect the exclusive zone. This MUST stay false.
     *
     * Waybar reserves 44px at the top of this monitor (`reserved=[0, 44, 0, 0]`)
     * and rofi honoured that. With `true` anyrun would be free to draw over the
     * bar, and because it is vertically centred its click-outside-to-close
     * surface would sit across the bar and swallow clicks on it. `false` keeps
     * the runner inside the usable area exactly as rofi was.
     */
    ignore_exclusive_zones: false,

    layer: Overlay,

    // Clicking outside the box closes it, matching the rofi behaviour.
    close_on_click: true,

    // Nothing is shown until something is typed. This matters because the
    // symbols plugin matches very broadly and would otherwise open the runner
    // on a wall of glyphs.
    show_results_immediately: false,

    max_entries: None,

    plugins: [
        "libapplications.so",
        "libactions.so",
        "librink.so",
        "libshell.so",
        "libsymbols.so",
        "libwebsearch.so",
    ],

    keybinds: [
        Keybind(
            key: "Return",
            action: Select,
        ),
        Keybind(
            key: "Up",
            action: Up,
        ),
        Keybind(
            key: "Down",
            action: Down,
        ),
        Keybind(
            key: "ISO_Left_Tab",
            action: Up,
            shift: true,
        ),
        Keybind(
            key: "Tab",
            action: Down,
        ),
        Keybind(
            key: "Escape",
            action: Close,
        ),
    ],
)
