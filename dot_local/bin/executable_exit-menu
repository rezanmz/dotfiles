#!/usr/bin/env sh
# Session menu for Hyprland (SUPER+M): lock, log out, suspend, reboot, power off.
set -eu

entries='Lock
Suspend
Log out to ly
Reboot
Power off'

choice="$(printf '%s\n' "$entries" | fuzzel --dmenu --prompt 'session> ' --lines 5 --width 20)" || exit 0
[ -n "$choice" ] || exit 0

case "$choice" in
    Lock)
        exec hyprlock
        ;;
    Suspend)
        exec systemctl suspend
        ;;
    "Log out to ly")
        # uwsm stops the graphical session and hands the tty back to ly.
        exec uwsm stop
        ;;
    Reboot)
        exec systemctl reboot
        ;;
    "Power off")
        exec systemctl poweroff
        ;;
esac
