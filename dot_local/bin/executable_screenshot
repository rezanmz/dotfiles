#!/usr/bin/env sh
# Screenshots for Hyprland — a thin wrapper over the shell's capture singleton.
#   screenshot region   — select an area
#   screenshot full     — whole monitor
#   screenshot window   — active window
#   screenshot output   — whole monitor (kept for old callers; same as full)
#
# The implementation lives in the shell now (dot_config/quickshell/Capture.qml):
# one code path for the macOS-style naming ("Screenshot 2026-10-17 at
# 20.15.32.png"), the save location, the timer and the floating thumbnail —
# annotation opens from the thumbnail (satty) instead of freezing the screen
# here. This only forwards to the running shell over IPC.
set -eu

mode="${1:-region}"

case "$mode" in
    region)        fn=selection ;;
    full | output) fn=screen ;;
    window)        fn=window ;;
    *)
        printf 'usage: %s [region|full|window|output]\n' "$0" >&2
        exit 2
        ;;
esac

exec qs ipc call capture "$fn"
