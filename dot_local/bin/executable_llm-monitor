#!/usr/bin/env python3
"""llm-monitor — nvtop-style live graphs for a running llama.cpp server.

Layout follows nvtop's: each panel is a plain box whose *bottom border is the time axis*, y labels sit outside the
left border at even ticks, and the series is drawn as a thin stepped line (─ horizontal, │ vertical) rather than a
filled bar.  Legend and readout live on the first row inside the box.

Panels: generation tok/s, prefill tok/s, prompt-cache tokens.

Counter notes, both measured:
  * n_prompt_tokens           the CONTEXT size; it keeps growing during generation (one per token)
  * n_prompt_tokens_processed how much of the prompt has been evaluated — the real prefill counter
  * n_prompt_tokens_cache     prompt tokens served from the server's cache for the current request
All three are per-request and snap to 0 when one finishes, so a decrease is a request boundary, not negative
throughput: the finished work goes into the session totals and that tick reads 0.

Strata models are not handled here; `llm monitor` delegates those to `strata monitor`.
"""

import argparse
import json
import shutil
import signal
import sys
import time
import urllib.request

R = "\033[0m"
D = "\033[2m"
B = "\033[1m"
GREEN = "\033[32m"
CYAN = "\033[36m"
MAGENTA = "\033[35m"
RED = "\033[31m"
HOME = "\033[H"
CLEAR_BELOW = "\033[J"

# Plot height must be 4k+1 so five y ticks land on whole rows (0, 1/4, 1/2, 3/4, 1).  4 rows gave max at the top,
# half two rows down and 0 one row below that: visibly uneven, the thing that looks wrong next to nvtop.
PLOT_H = 5


def hnum(x):
    if x <= 0:
        return "0"
    if x >= 1_000_000:
        return f"{x/1_000_000:.1f}M"
    if x >= 10_000:
        return f"{x/1_000:.0f}k"
    if x >= 1_000:
        return f"{x/1_000:.1f}k"
    if x >= 10:
        return f"{x:.0f}"
    return f"{x:.1f}"


def steps(vals, width, height, ceiling=None):
    """A stepped line drawn right-aligned over the samples that exist.

    Two things make it read as a line rather than a dotted mess:
      * no zero padding — an empty window draws nothing, instead of a fake horizontal rule along the bottom,
      * corners (╮╰╯╭) where the value changes, so the horizontal and vertical strokes actually join.
    """
    empty = [" " * width] * height
    n = len(vals)
    if n < 2:
        return empty
    v = list(vals)
    hi = ceiling or (max(v) or 1.0)
    # Fill the width.  With fewer samples than columns the history is stretched across the whole plot (one sample per
    # column by nearest-neighbour), so the chart reads as a chart from the first seconds instead of a stub hugging the
    # right edge; once the window is full it is one sample per column again.
    if n < width:
        v = [v[round(c * (n - 1) / (width - 1))] for c in range(width)]
    else:
        v = v[-width:]
    rows = [height - 1 - min(height - 1, max(0, int(round((x / hi) * (height - 1))))) for x in v]
    grid = [[" "] * width for _ in range(height)]
    off = 0
    for k, r in enumerate(rows):
        x = off + k
        if k == 0:
            grid[r][x] = "─"
            continue
        p = rows[k - 1]
        if r == p:
            grid[r][x] = "─"
        elif r > p:                      # value fell: come in from the left, go down, leave to the right
            grid[p][x] = "╮"
            for y in range(p + 1, r):
                grid[y][x] = "│"
            grid[r][x] = "╰"
        else:                            # value rose
            grid[p][x] = "╯"
            for y in range(r + 1, p):
                grid[y][x] = "│"
            grid[r][x] = "╭"
    return ["".join(row) for row in grid]


def panel(title, readout, vals, width, colour, span, ceiling=None):
    """One box in nvtop's shape: y labels outside the left edge, the tick drawn ON the border column (so ┤ lines up
    with ┌ │ └), a plain top border, and a bottom border that is the time axis."""
    GUT = 6
    plot_w = max(8, width - GUT - 2)     # labels + left border + plot + right border
    out = [" " * GUT + "┌" + "─" * plot_w + "┐"]

    legend = f"{title} {readout}"
    legend = legend[: plot_w - 1]
    pad = plot_w - 1 - len(title) - 1 - len(readout)
    out.append(" " * GUT + "│ " + colour + B + title + R + " " + D + readout + R + " " * max(0, pad) + "│")

    top_val = ceiling or (max(vals) if vals else 0.0)
    n_ticks = min(5, PLOT_H)
    for i, row in enumerate(steps(vals, plot_w, PLOT_H, ceiling)):
        lab = hnum(top_val * (1 - i / (PLOT_H - 1))) if (i * (n_ticks - 1)) % (PLOT_H - 1) == 0 else ""
        tick = "┤" if lab else "│"
        out.append(f"{D}{lab:>{GUT}}{R}" + tick + colour + row + R + "│")

    buf = ["─"] * plot_w
    def put(text, pos):
        for k, ch in enumerate(text):
            if 0 <= pos + k < plot_w:
                buf[pos + k] = ch
    for text, pos in ((f"-{span}s", 0), (f"-{span * 3 // 4}s", plot_w // 4),
                      (f"-{span // 2}s", plot_w // 2), (f"-{span // 4}s", 3 * plot_w // 4),
                      ("now", max(0, plot_w - 3))):
        put(text, pos)
    out.append(" " * GUT + "└" + D + "".join(buf) + R + "┘")
    return out


def build(port, name, series, stats, width, span, err=None):
    w = max(40, min(width, 140))
    out = [f" {B}{name or 'model'}{R}  {D}127.0.0.1:{port}{R}" + (f"   {RED}{err}{R}" if err else "")]

    for title, s, colour, unit in (
        ("generation", series["gen"], GREEN, "tok/s"),
        ("prefill", series["pre"], CYAN, "tok/s"),
        ("prompt cache", series["cache"], MAGENTA, "tokens"),
    ):
        readout = f"now {hnum(s.now())}  avg {hnum(s.avg())}  peak {hnum(s.peak())} {unit}"
        out.extend(panel(title, readout, s.v, w, colour, max(1, len(s.v)), s.scale))

    out.append(
        f" {D}generated{R} {B}{hnum(stats['gen_total'])}{R}  {D}prefilled{R} {B}{hnum(stats['pre_total'])}{R}  "
        f"{D}cached{R} {B}{hnum(stats['cache_now'])}{R}  {D}requests{R} {B}{stats['requests']}{R}  "
        f"{'busy' if stats['busy'] else 'idle'}  {D}ctrl-c to leave{R}"
    )
    return out


def nice_ceiling(v):
    """A round upper bound (1, 2, 2.5, 5 x 10^n) so the axis reads 0/25/50/75/100 rather than 0/12.3/24.6."""
    if v <= 0:
        return 10.0
    import math
    e = 10 ** math.floor(math.log10(v))
    # Ladder chosen so the quarter marks are round: 80/60/40/20, 100/75/50/25, 60/45/30/15, not 56/38/19.
    for m in (1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10):
        if v <= m * e:
            return m * e
    return 10 * e


class Series:
    def __init__(self, window):
        self.window = window
        self.v = []
        self.scale = 10.0  # sticky: only grows. Re-fitting every frame makes the line jump up and down.

    def add(self, x):
        self.v.append(float(x))
        if len(self.v) > self.window:
            self.v = self.v[-self.window:]
        if x > self.scale:
            self.scale = nice_ceiling(x)

    def now(self):
        return self.v[-1] if self.v else 0.0

    def avg(self):
        nz = [x for x in self.v if x > 0]
        return (sum(nz) / len(nz)) if nz else 0.0

    def peak(self):
        return max(self.v) if self.v else 0.0


def get(url, timeout=3.0):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8080)
    ap.add_argument("--name", default="")
    ap.add_argument("--interval", type=float, default=1.0)
    ap.add_argument("--window", type=int, default=None)
    ap.add_argument("--once", action="store_true", help="one reading and exit (for scripts)")
    a = ap.parse_args()

    base = f"http://127.0.0.1:{a.port}"
    line_rows = shutil.get_terminal_size((100, 24)).lines
    cols = max(40, min(shutil.get_terminal_size((100, 24)).columns, 140))
    # PLOT_H from the terminal: 4k+1 rows, whatever fits three panels.
    global PLOT_H
    # Three panels, each PLOT_H+3 lines (top, legend, plot, axis), plus a header and a footer.
    # 4k+1 rows fit five even ticks; 4 rows fall back to four (max, 2/3, 1/3, 0) so a 24-line terminal is not overrun.
    avail = (line_rows - 11) // 3
    PLOT_H = 4 if avail < 5 else min(13, ((avail - 1) // 4) * 4 + 1)
    plot_w = max(20, cols - 11)
    window = a.window or plot_w
    series = {k: Series(window) for k in ("gen", "pre", "cache")}

    prev = None
    gen_total = pre_total = 0
    requests = 0
    t0 = time.time()
    first = True

    def bye(*_):
        sys.stdout.write(R + "\n")
        sys.stdout.flush()
        raise SystemExit(0)

    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGTERM, bye)

    while True:
        err = None
        try:
            slots = get(base + "/slots")
        except Exception:
            slots, err = [], "not answering"

        proc_now = sum(s.get("n_prompt_tokens_processed") or 0 for s in slots)
        dec_now = sum((s.get("next_token") or [{}])[0].get("n_decoded") or 0 for s in slots)
        cache_now = sum(s.get("n_prompt_tokens_cache") or 0 for s in slots)
        busy = any(s.get("is_processing") for s in slots)

        if prev is None:
            d_p = d_g = 0.0
        else:
            pp, gg = prev
            if proc_now >= pp:
                d_p = (proc_now - pp) / a.interval
            else:
                pre_total += pp
                d_p = 0.0
            if dec_now >= gg:
                d_g = (dec_now - gg) / a.interval
            else:
                gen_total += gg
                requests += 1
                d_g = 0.0

        series["gen"].add(d_g)
        series["pre"].add(d_p)
        series["cache"].add(cache_now)
        prev = (proc_now, dec_now)

        stats = {
            "gen_total": gen_total + dec_now,
            "pre_total": pre_total,
            "cache_now": cache_now,
            "requests": requests,
            "busy": busy,
        }

        lines = build(a.port, a.name, series, stats, shutil.get_terminal_size((100, 24)).columns, window, err)
        if a.once:
            print("\n".join(l.replace(R, "").replace(D, "").replace(B, "") for l in lines))
            return
        sys.stdout.write(("\033[2J" if first else "") + HOME + "\n".join(lines) + "\n" + CLEAR_BELOW)
        sys.stdout.flush()
        first = False
        time.sleep(a.interval)


if __name__ == "__main__":
    main()
