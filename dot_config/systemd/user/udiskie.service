[Unit]
Description=udiskie — automount removable drives (USB sticks, SD cards)
Documentation=https://github.com/coldfix/udiskie
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# udisks2 does the actual mounting; without it udiskie's D-Bus calls go nowhere.
After=udisks2.service
Wants=udisks2.service

[Service]
Type=simple
# --automount : mount a device as soon as it is plugged in. This is the whole
#               point; without it udiskie only mounts on demand.
# --notify    : desktop notification on mount/unmount, so a plug is visible
#               rather than silent.
# --smart-tray: tray icon that appears only while a device is mounted. The bar
#               stays clean when nothing is attached, which suits a status bar
#               that is already carrying eleven modules.
# --file-manager: what the tray's "browse" action opens. yazi runs in a terminal,
#               so it needs the terminal wrapper; `kitty yazi <path>` is the same
#               invocation as the SUPER+E bind in 60-binds.lua.
# --config    : keeps the above in one declarative place instead of a long
#               ExecStart that is easy to get out of sync.
ExecStart=/usr/bin/udiskie --automount --notify --smart-tray --config=%h/.config/udiskie/config.yml
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=graphical-session.target
