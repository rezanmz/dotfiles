providers:
  webSearchOrder:
    - ecosia
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - startpage
    - duckduckgo
    - google
    - mojeek
    - public
modelRoles:
{{- if eq .machine "work" }}
  default: github-copilot/gpt-5.6-terra:high
  slow: github-copilot/claude-opus-5:max
  smol: github-copilot/gemini-3.7-flash:low
  vision: github-copilot/claude-sonnet-5:high
  plan: github-copilot/gpt-5.6-sol:xhigh
  designer: github-copilot/claude-sonnet-5:high
  commit: github-copilot/gpt-5.6-luna:low
  tiny: github-copilot/gpt-5.6-luna:low
  task: github-copilot/gpt-5.6-terra:high
  advisor: github-copilot/grok-4.6:high
{{- else }}
  default: opencode-go/muse-spark-1.3-contributor:high
  slow: opencode-go/muse-spark-1.3-contributor:xhigh
  smol: opencode-go/deepseek-v4-flash
  vision: opencode-go/muse-spark-1.3-contributor:high
  plan: opencode-go/muse-spark-1.3-contributor:xhigh
  designer: opencode-go/muse-spark-1.3-contributor:high
  commit: opencode-go/deepseek-v4-flash:low
  tiny: opencode-go/deepseek-v4-flash:minimal
  task: opencode-go/muse-spark-1.3-contributor:high
  advisor: opencode-go/muse-spark-1.3-contributor:high
{{- end }}
advisor:
  enabled: false
task:
  eager: preferred
  batch: true
  maxConcurrency: {{ if eq .machine "work" }}8{{ else }}4{{ end }}
  maxRecursionDepth: {{ if eq .machine "work" }}2{{ else }}1{{ end }}
  softRequestBudget: {{ if eq .machine "work" }}200{{ else }}100{{ end }}
  enableEffort: true
  enableLsp: true
  showResolvedModelBadge: true
  isolation:
    apply: true
    merge: patch
    enabled: true
  agentModelOverrides:
    security-reviewer: "@slow"
retry:
  enabled: true
  modelFallback: true
  usageAwareFallback: false
  fallbackChains:
{{- if eq .machine "work" }}
    default:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/grok-4.6:high
    slow:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-4.8:high
    plan:
      - github-copilot/claude-opus-5:max
      - github-copilot/claude-opus-4.8:high
    smol:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash:low
    task:
      - github-copilot/gpt-5.6-sol
      - github-copilot/gpt-5.3-codex:high
    vision:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    designer:
      - github-copilot/gemini-3.7-flash:high
      - github-copilot/gpt-5.6-terra:high
    commit:
      - github-copilot/mai-code-1.1-flash
    tiny:
      - github-copilot/mai-code-1.1-flash
    advisor:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gpt-5.6-terra:high
{{- else }}
    default:
      - openrouter/meta/muse-spark-1.3-contributor:high
      - openrouter/z-ai/glm-5.3-flash:high
    slow:
      - openrouter/meta/muse-spark-1.3-contributor:xhigh
      - openrouter/z-ai/glm-5.3:high
    plan:
      - openrouter/meta/muse-spark-1.3-contributor:xhigh
      - openrouter/z-ai/glm-5.3:high
    smol:
      - openrouter/deepseek/deepseek-v4-flash:medium
    task:
      - openrouter/meta/muse-spark-1.3-contributor:high
      - openrouter/z-ai/glm-5.3-flash:high
    vision:
      - openrouter/meta/muse-spark-1.3:high
      - openrouter/z-ai/glm-5.3-flash:high
    designer:
      - openrouter/meta/muse-spark-1.3:high
      - openrouter/z-ai/glm-5.3-flash:high
    commit:
      - openrouter/deepseek/deepseek-v4-flash:low
    tiny:
      - openrouter/deepseek/deepseek-v4-flash:low
    advisor:
      - openrouter/meta/muse-spark-1.3:high
      - openrouter/z-ai/glm-5.3:high
{{- end }}
symbolPreset: nerd
theme:
  dark: titanium
  light: light
setupVersion: 2
dev:
  autoqaConsent: granted
composer:
  shape: box
defaultThinkingLevel: auto
isolation:
  backend: auto
memory:
  backend: local
checkpoint:
  enabled: true
secrets:
  enabled: true
compaction:
  idleEnabled: true
  handoffSaveToDisk: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
terminal:
  showProgress: true
statusLine:
  preset: custom
  leftSegments:
    - model
    - mode
    - path
    - git
    - pr
  rightSegments:
    - context_pct
    - token_total
    - cost
    - time_spent
    - subagents
    - status