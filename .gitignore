# Preserve the harness's deepwork artifacts while ignoring other local state.
.slim/deepwork/

# macOS/editor/build noise.
.DS_Store
.AppleDouble
*.swp
*.swo
*~

# Runtime state and generated output.
.cache/
.local/state/
*.log
*.pid
coverage/
dist/
build/

# Credentials and private machine material: never add these to the source state.
.env
.env.*
!.env.example
**/.aws/
**/.config/gcloud/
**/.docker/
**/.gnupg/
**/.kube/
**/.ssh/
**/*credentials*
**/*secret*
**/*token*
**/*.age
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*identity*
**/*history*

# Chezmoi-encoded credential roots/files must never enter public source.
dot_ssh/
private_dot_ssh/
dot_aws/
private_dot_aws/
dot_gnupg/
private_dot_gnupg/
dot_docker/
private_dot_docker/
dot_kube/
private_dot_kube/
dot_azure/
private_dot_azure/
dot_netrc
private_dot_netrc
dot_airexplorer/
private_dot_airexplorer/
dot_config/gcloud/
private_dot_config/gcloud/
dot_config/kube/
private_dot_config/kube/
dot_config/docker/
private_dot_config/docker/
dot_config/context7/
private_dot_config/context7/
dot_config/gh/
private_dot_config/gh/
dot_config/github/
private_dot_config/github/
dot_config/sops/
private_dot_config/sops/
dot_config/age/
private_dot_config/age/
dot_config/airexplorer/
private_dot_config/airexplorer/
dot_config/rclone/
private_dot_config/rclone/
dot_config/sunshine/
private_dot_config/sunshine/
dot_local/share/rclone/
dot_env*
private_dot_env*
dot_*credentials*
private_dot_*credentials*
dot_*secret*
private_dot_*secret*
dot_*token*
private_dot_*token*
dot_*key*
private_dot_*key*

# OMP/OpenCode databases, sessions, and runtime state are local; declarative
# configuration templates remain trackable.
private_dot_omp/**/db*
private_dot_omp/**/database*
private_dot_omp/**/session*/
private_dot_omp/**/state/
private_dot_omp/**/logs/
private_dot_config/opencode/**/db*
private_dot_config/opencode/**/database*
private_dot_config/opencode/**/session*/
private_dot_config/opencode/**/state/
.omp/**/db*
.omp/**/database*
.omp/**/session*/
.omp/**/state/
dot_omp/**/db*
dot_omp/**/database*
dot_omp/**/session*/
dot_omp/**/state/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
