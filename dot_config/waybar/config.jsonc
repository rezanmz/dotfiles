// Waybar: Dracula, one row, right-anchored status cluster.
// Nerd Font glyphs live in the Unicode private use area. They are written here
// as JSON \u escapes so the file itself stays plain ASCII and cannot be mangled
// by tooling; waybar decodes them at parse time. With the Nerd Font installed
// (ttf-hack-nerd) these render as icons; without it they fall back to the text
// labels below.

{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 8,
    "margin-top": 0,
    "margin-left": 10,
    "margin-right": 10,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["pulseaudio", "network", "bluetooth", "cpu", "memory", "temperature", "disk", "clock", "tray"],

    // Workspaces are listed as they exist: only workspaces that actually have a
    // window appear, so no empty 6/7/8/9 clutter. (An invalid "num-workspaces"
    // key was here before; waybar silently ignored it.)
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Google Chrome": "$1",
            "(.*) - Chromium": "$1"
        }
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#ff79c6'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "interval": 5,
        "format": "cpu {usage}%",
        "on-click": "kitty -e htop"
    },

    "memory": {
        "interval": 10,
        "format": "ram {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted \uf026",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{signalStrength}% \uf1eb",
        "format-ethernet": "eth \uf6ff",
        "format-disconnected": "offline \uf127",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "interval": 10,
        "format": "\uf293 {num_connections}",
        "format-disabled": "\uf293 off",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty -e bluetui"
    },

    "temperature": {
        // hwmon-path-abs pins the CPU sensor by PCI path: plain hwmonN numbering
        // is assigned in probe order and changes between boots.
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "format": "{temperatureC}°C",
        "tooltip-format": "CPU (Tctl): {temperatureC}°C",
        "warning-threshold": 75,
        "critical-threshold": 90
    },

    "disk": {
        // Root is a single LVM/btrfs volume, so one entry is enough. Note the
        // space in the mount point has to be escaped in the JSON key.
        "interval": 30,
        "format": "{used}",
        "tooltip-format": "root: {used} / {total} ({percentage_used}%)",
        "path": "/",
        "unit": "GiB"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
