providers:
  webSearchOrder:
    - ecosia
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - startpage
    - duckduckgo
    - google
    - mojeek
    - public
modelRoles:
{{- if eq .machine "work" }}
  default: github-copilot/gpt-6.1-sol:xhigh
  slow: github-copilot/claude-opus-5.5:max
  smol: github-copilot/claude-haiku-5.5:medium
  vision: github-copilot/gpt-6.1-sol:high
  plan: github-copilot/claude-sonnet-5.5:xhigh
  designer: github-copilot/claude-sonnet-5.5:high
  commit: github-copilot/gpt-6-luna:low
  tiny: github-copilot/gpt-6-luna:low
  task: github-copilot/gpt-6.1-sol:medium
  advisor: github-copilot/claude-sonnet-5.5:xhigh
{{- else }}
  # Every personal role runs on the 9Router `chat` combo (MiMo-Flash ->
  # GPT-Luna -> Deepseek-Flash -> GLM-Flash); per-role thinking effort is
  # preserved. The previous direct-model primaries head each role's
  # fallback chain below.
  default: 9router/chat:high
  slow: 9router/chat:xhigh
  smol: 9router/chat
  vision: 9router/chat:high
  plan: 9router/chat:xhigh
  designer: 9router/chat:high
  commit: 9router/chat:low
  tiny: 9router/chat:minimal
  task: 9router/chat:high
  advisor: 9router/chat:high
{{- end }}
advisor:
  enabled: false
task:
  eager: preferred
  batch: true
  maxConcurrency: {{ if eq .machine "work" }}8{{ else }}4{{ end }}
  maxRecursionDepth: {{ if eq .machine "work" }}2{{ else }}1{{ end }}
  softRequestBudget: {{ if eq .machine "work" }}200{{ else }}100{{ end }}
  enableEffort: true
  enableLsp: true
  showResolvedModelBadge: true
  isolation:
    apply: true
    merge: patch
    enabled: true
  agentModelOverrides:
    security-reviewer: "@slow"
retry:
  enabled: true
  modelFallback: true
  usageAwareFallback: false
  fallbackChains:
{{- if eq .machine "work" }}
    # Each chain starts with the role's previous primary, then a
    # cross-vendor alternative.
    default:
      - github-copilot/gpt-5.6-terra:high
      - github-copilot/claude-sonnet-5.5:xhigh
    slow:
      - github-copilot/claude-opus-5:max
      - github-copilot/gpt-6.1-sol:max
    plan:
      - github-copilot/gpt-5.6-sol:xhigh
      - github-copilot/claude-opus-5.5:high
    smol:
      - github-copilot/gemini-3.7-flash:low
      - github-copilot/gpt-6-luna:medium
    task:
      - github-copilot/gpt-5.6-terra:high
      - github-copilot/claude-sonnet-5.5:high
    vision:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gemini-3.8-flash:high
    designer:
      - github-copilot/claude-sonnet-5:high
      - github-copilot/gpt-6.1-sol:high
    commit:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash
    tiny:
      - github-copilot/gpt-5.6-luna:low
      - github-copilot/mai-code-1.1-flash
    advisor:
      - github-copilot/grok-4.6:high
      - github-copilot/gpt-6.1-sol:high
{{- else }}
    # The 9Router `chat` combo is now the role primary (modelRoles above);
    # each chain starts with the role's previous 9Router primary (chat's
    # predecessor role -> `smart`), then the older direct-provider
    # fallbacks.
    default:
      - 9router/smart:high
      - opencode-go/qwen3.8-flash:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    slow:
      - 9router/smart:xhigh
      - openrouter/deepseek/deepseek-v4.1-flash:max
      - opencode-go/qwen3.8-max:high
      - openrouter/qwen/qwen3.8-max:xhigh
      - openrouter/moonshotai/kimi-k3:max
    plan:
      - 9router/smart:xhigh
      - openrouter/deepseek/deepseek-v4.1-flash:max
      - opencode-go/qwen3.8-max:high
      - openrouter/qwen/qwen3.8-max:xhigh
      - openrouter/moonshotai/kimi-k3:max
    smol:
      - 9router/smart:high
      - opencode-go/deepseek-v4-flash
      - opencode-go/qwen3.8-flash
      - openrouter/deepseek/deepseek-v4.1-flash
      - openrouter/qwen/qwen3.8-flash
    task:
      - 9router/smart:high
      - opencode-go/qwen3.8-flash:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    vision:
      - 9router/smart:high
      - opencode-go/qwen3.8-flash:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    designer:
      - 9router/smart:high
      - opencode-go/qwen3.8-flash:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
    commit:
      - 9router/smart:high
      - opencode-go/deepseek-v4-flash:low
      - opencode-go/qwen3.8-flash:low
      - openrouter/deepseek/deepseek-v4.1-flash:low
      - openrouter/qwen/qwen3.8-flash:low
    tiny:
      - 9router/smart:high
      - opencode-go/deepseek-v4-flash:minimal
      - opencode-go/qwen3.8-flash:minimal
      - openrouter/deepseek/deepseek-v4.1-flash:low
      - openrouter/qwen/qwen3.8-flash:minimal
    advisor:
      - 9router/smart:high
      - opencode-go/qwen3.8-flash:high
      - opencode-go/glm-5.3-flash:high
      - openrouter/qwen/qwen3.8-flash:high
      - openrouter/z-ai/glm-5.3-flash:high
{{- end }}
symbolPreset: nerd
theme:
  dark: titanium
  light: light
setupVersion: 2
dev:
  autoqaConsent: granted
composer:
  shape: box
defaultThinkingLevel: auto
isolation:
  backend: auto
memory:
  backend: local
checkpoint:
  enabled: true
secrets:
  enabled: true
compaction:
  # Upstream default is false. Enabling it silently rewrites the live
  # session's model context 5 minutes after you stop typing whenever the
  # context is above idleThresholdTokens (200k) — far below the ~850k
  # normal auto-compaction threshold on a 1M window — so walking away
  # from a mid-size session destroys the conversation the model sees.
  idleEnabled: false
  handoffSaveToDisk: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
terminal:
  showProgress: true
statusLine:
  preset: custom
  leftSegments:
    - model
    - mode
    - path
    - git
    - pr
  rightSegments:
    - context_pct
    - token_total
    - cost
    - time_spent
    - subagents
    - status