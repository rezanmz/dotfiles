#!/bin/sh
# Toggle the Thunderbird scratchpad.
#
# Two behaviours, because Hyprland already helps with one of them:
#
#   Thunderbird running  -> toggle the scratchpad's visibility (hide/show)
#   Thunderbird stopped  -> start it and WAIT, but do not toggle
#
# The second case is the subtle one. The window rule in 70-rules.lua moves the
# window to special:scratchpad, and Hyprland *automatically reveals* the special
# workspace when a window is placed there. Toggling after launching therefore
# hides what the rule just showed, leaving the window on the scratchpad while
# the screen appears empty.
#
# A bare `toggle_special` is also a no-op when the app is closed: the screen
# just dims on an empty workspace, which is what prompted this script.
set -eu

TOGGLE='hl.dsp.workspace.toggle_special("scratchpad")'

on_scratchpad() {
    hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for c in clients:
    if c.get("class", "").startswith("org.mozilla.Thunderbird") \
       and c.get("workspace", {}).get("name") == "special:scratchpad":
        sys.exit(0)
sys.exit(1)
'
}

# Already running: plain visibility toggle.
if pgrep -x thunderbird >/dev/null 2>&1; then
    hyprctl dispatch "$TOGGLE" >/dev/null
    exit 0
fi

# Not running: start it and wait for the rule to place it. No toggle.
setsid thunderbird >/dev/null 2>&1 &

i=0
while [ "$i" -lt 60 ]; do
    if on_scratchpad; then
        exit 0
    fi
    sleep 0.5
    i=$((i + 1))
done

# Timed out: say so rather than leaving the user with a blank look.
hyprctl notify 2 5000 "rgb(ff5555)" "Thunderbird did not reach the scratchpad in 30s"
exit 1
