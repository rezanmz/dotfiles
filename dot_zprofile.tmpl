# Docker Desktop was installed on macOS; its PATH entry does not apply on Linux.
if [[ "$OSTYPE" == darwin* ]]; then
  export PATH="$PATH:/Users/rezanmz/.docker/bin"
fi

# Initialize Homebrew only on supported macOS architectures and when installed.
if [[ "$OSTYPE" == darwin* ]]; then
  _brew_bin=""
  case "$(uname -m)" in
    arm64) _brew_bin="/opt/homebrew/bin/brew" ;;
    x86_64) _brew_bin="/usr/local/bin/brew" ;;
  esac
  if [[ -x "$_brew_bin" ]]; then
    eval "$("$_brew_bin" shellenv)"
  elif (( $+commands[brew] )); then
    eval "$(brew shellenv)"
  fi
  unset _brew_bin
fi

# User-local binaries (omp, helper scripts) come first for interactive shells.
if [[ -d "$HOME/.local/bin" ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi
